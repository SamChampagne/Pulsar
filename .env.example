# Copy to .env at the repository root. All workspaces read from this file.

# --- Database ---
DATABASE_URL="postgresql://pulsar:pulsar@localhost:5432/pulsar?schema=public"

# --- API ---
API_PORT=3000
API_CORS_ORIGIN=http://localhost:5173
# Public base URL of the API (used to build OIDC redirect URIs)
API_URL=http://localhost:3000

# --- Auth ---
# Generate a real secret for anything beyond local dev: openssl rand -base64 48
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=15m
REFRESH_EXPIRES_DAYS=30

# Platform plane (cross-tenant ops). In production the API refuses to start
# if this is unset or still the default.
PLATFORM_ADMIN_EMAIL=platform@pulsar.dev
PLATFORM_ADMIN_PASSWORD=admin123

# --- Web (used to build public links: tender, tracking, driver) ---
WEB_URL=http://localhost:5173

# --- Email ---
# log (dev/CI): emails go to the application log. smtp: real delivery.
EMAIL_DRIVER=log
EMAIL_FROM="Pulsar <no-reply@pulsar.local>"
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# --- Secrets at rest ---
# 32 bytes, base64. The API refuses to start without it.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=q8mB3dT9rV2xU5nC7sE4hG1jL0aF3kM8oP4wY6zI1tQ=

# --- File storage ---
# local (dev): files under apps/api/storage. s3: any S3-compatible bucket.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=storage
# S3_BUCKET=pulsar-documents
# S3_REGION=ca-central-1
# S3_ENDPOINT=            # leave empty for AWS; set for MinIO/R2
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true

# --- Mapping engine (phase 10) ---
# none (default, also CI): no road distances/geocoding — manual values only.
# osrm: self-hosted OSRM (docker compose --profile osrm up -d). See docs/getting-started.md.
ROUTING_DRIVER=none
# OSRM_HOST=http://localhost:5000
# nominatim: best-effort address→lat/lng with persistent DB cache (1 req/s).
GEOCODING_DRIVER=none
# NOMINATIM_HOST=https://nominatim.openstreetmap.org

# --- Phase 11 palier 2a: AI employee-agents (Hermes ACP, opt-in, best-effort) ---
# Secret for short-lived agent session tokens that let the Hermes runtime call /mcp.
# MUST be set in non-dev environments (falls back to JWT_SECRET, then an insecure dev default).
AGENT_SESSION_SECRET=
# Where the Hermes ACP runtime is invoked from (the vendored hermes-agent/ Python env).
# The API spawns: <HERMES_ACP_CMD> <HERMES_ACP_ARGS> (stdio) per conversation.
HERMES_ACP_CMD=python
HERMES_ACP_ARGS=-m acp_adapter
HERMES_ACP_CWD=./hermes-agent
# The MCP endpoint Hermes calls back into (defaults to localhost:3000).
PULSAR_MCP_URL=http://localhost:3000/api/v1/mcp
# Gate for the conditional real-Hermes e2e smoke test (off in CI).
HERMES_ENABLED=
