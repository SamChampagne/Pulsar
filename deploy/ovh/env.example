# Copy to deploy/ovh/.env (ignored by Git). Never use the root demo seed remotely.
# Use the exact reviewed commit/tag; do not silently deploy a moving latest tag.
PULSAR_BUILD_VERSION=REPLACE_WITH_TESTED_COMMIT
# openssl rand -hex 32 (hex is safe inside DATABASE_URL without URL encoding)
POSTGRES_PASSWORD=
# openssl rand -hex 48
JWT_SECRET=
# openssl rand -base64 32 — BACK UP THIS KEY or encrypted tenant credentials are lost
ENCRYPTION_KEY=
PLATFORM_ADMIN_EMAIL=
# Unique password, >=16 chars, <=72 UTF-8 bytes. Keep in your password manager.
# Rerunning bootstrap does NOT rotate an existing account password or reset MFA.
PLATFORM_ADMIN_PASSWORD=
