# Example for Nginx installed on the HOST. Do not replace nginx.conf globally.
# Install only after DNS and these certificate paths are verified on the VPS.
server {
    listen 80;
    server_name pulsar.intebec.ca;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name pulsar.intebec.ca;
    ssl_certificate /etc/letsencrypt/live/pulsar.intebec.ca/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/pulsar.intebec.ca/privkey.pem;
    client_max_body_size 25m;

    # For a private pilot, restrict source IPs here or put this host behind a
    # VPN/access gateway BEFORE opening it to external testers.
    location / {
        proxy_pass http://127.0.0.1:8180;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_read_timeout 3600s;
    }
}
