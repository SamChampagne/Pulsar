# OFFLINE TEST IMAGE ONLY. It is never used by the API or the OVH compose.
# First build the matching API image, then create the source manifest (README).
ARG API_IMAGE=pulsar-api:control-center-test
FROM ${API_IMAGE} AS api
FROM ghcr.io/astral-sh/uv:0.12.19@sha256:04d046b13e60d6bcec73cbc5e1cad25d680dea90c8573340950a0ac2d1aef424 AS uv
FROM node:22-bookworm-slim@sha256:43ac6c60b8f89723f746e8a92ce91abd5017e627ce1ddfe4238355d3a30b772c AS qualification
COPY --from=uv /uv /usr/local/bin/uv
WORKDIR /app
# Only pure JS ACP/shared code is exercised; the copied API is NEVER started.
COPY --from=api /app /app
COPY hermes-agent /app/hermes-agent
COPY scripts/qualify-agent-runtime.mjs scripts/runtime-source-manifest.mjs scripts/pulsar-hermes-acp.py scripts/pulsar-hermes-turns.py scripts/
COPY scripts/fixtures/hermes-qualification-entry.py scripts/fixtures/
COPY deploy/agents/runtime-manifest.generated.json deploy/agents/runtime-manifest.generated.json
ENV UV_PYTHON_INSTALL_DIR=/opt/python UV_LINK_MODE=copy UV_NO_CACHE=1
RUN uv python install 3.12.13 \
 && uv sync --project /app/hermes-agent --locked --no-dev --extra acp --extra mcp --python 3.12.13 \
 && chmod -R a+rX /opt/python /app/hermes-agent/.venv
USER node
CMD ["node", "scripts/qualify-agent-runtime.mjs", "--container-reference"]
