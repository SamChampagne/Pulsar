// Pulsar — Prisma schema
//
// Multi-tenancy strategy: shared database, shared schema. Every tenant-scoped
// model carries a `tenantId` column and an index on it. Isolation is enforced
// at the application layer (every query in apps/api filters by the tenant
// resolved from the JWT). See docs/multi-tenancy.md.
//
// Status enums mirror packages/shared/src/enums — keep both in sync.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// CORE — tenants, identity, RBAC
// ============================================================================

enum TenantStatus {
  TRIAL
  ACTIVE
  SUSPENDED
}

model Tenant {
  id         String       @id @default(cuid())
  slug       String       @unique
  name       String
  status     TenantStatus @default(TRIAL)
  settings   Json         @default("{}")
  // OIDC SSO config: { enabled, issuer, clientId, clientSecret (enc:v1), defaultRoleId }
  authConfig Json?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  users                   User[]
  roles                   Role[]
  auditLogs               AuditLog[]
  documents               Document[]
  notifications           Notification[]
  integrations            Integration[]
  webhookDeliveries       WebhookDelivery[]
  apiKeys                 ApiKey[]
  modules                 TenantModule[]
  customers               Customer[]
  locations               Location[]
  carriers                Carrier[]
  drivers                 Driver[]
  vehicles                Vehicle[]
  trailers                Trailer[]
  transportOrders         TransportOrder[]
  shipments               Shipment[]
  loads                   Load[]
  tenders                 Tender[]
  lanePreferences         LaneCarrierPreference[]
  lanes                   Lane[]
  accessorials            Accessorial[]
  fuelSurchargeTables     FuelSurchargeTable[]
  invoices                Invoice[]
  routes                  Route[]
  stops                   Stop[]
  rates                   Rate[]
  trackingEvents          TrackingEvent[]
  proofsOfDelivery        ProofOfDelivery[]
  shipmentLoadLegs        ShipmentLoadLeg[]
  customerInvoices        CustomerInvoice[]
  agents                  Agent[]
  proposedActions         ProposedAction[]
  agentConversations      AgentConversation[]
  agentRuntimeConfig      AgentRuntimeConfig?
  agentRuns               AgentRun[]
  incomingCarrierInvoices IncomingCarrierInvoice[]
  maintenanceOrders       MaintenanceOrder[]
  maintenanceSchedules    MaintenanceSchedule[]
  complianceDocuments     ComplianceDocument[]
  maintenanceParts        MaintenancePart[]
  odometerReadings        OdometerReading[]
  fuelLogs                FuelLog[]
  inspectionTemplates     InspectionTemplate[]
  inspectionTemplateItems InspectionTemplateItem[]
  inspectionReports       InspectionReport[]
  inspectionItems         InspectionItem[]
  wmsItems                WmsItem[]
  wmsBins                 Bin[]
  inventoryLevels         InventoryLevel[]
  stockMovements          StockMovement[]
  receipts                Receipt[]
  pickOrders              PickOrder[]
  cycleCounts             CycleCount[]
  cycleCountLines         CycleCountLine[]
  yardSpots               YardSpot[]
  yardVisits              YardVisit[]
  yardMoves               YardMove[]
  dockAppointments        DockAppointment[]
  inboundMessages         InboundMessage[]
  importBatches           ImportBatch[]
  importRows              ImportRow[]
  rfps                    Rfp[]
  rfpLanes                RfpLane[]
  rfpInvites              RfpInvite[]
  bids                    Bid[]
  awards                  Award[]
  orderTemplates          OrderTemplate[]
  automationRules         AutomationRule[]
  crmCompanies            CrmCompany[]
  crmContacts             CrmContact[]
  crmDeals                CrmDeal[]
  crmActivities           CrmActivity[]
  crmLists                CrmList[]
  crmCampaigns            CrmCampaign[]
  crmProducts             CrmProduct[]
  salesOrders             SalesOrder[]
  emailConfig             TenantEmailConfig?
  emailMessages           EmailMessage[]
  emailTemplates          EmailTemplate[]
  emailThreads            EmailThread[]
  landingPages            LandingPage[]
  chartOfAccounts         ChartOfAccount[]
  journalEntries          JournalEntry[]
  payments                Payment[]
  modesOfPayment          ModeOfPayment[]
  taxTemplates            TaxTemplate[]
  bankAccounts            BankAccount[]
  budgets                 Budget[]
  fixedAssets             FixedAsset[]
  subscriptions           Subscription[]
  workingCalendars        WorkingCalendar[]
  workCenters             WorkCenter[]
  routings                Routing[]
  boms                    Bom[]
  manufacturingOrders     ManufacturingOrder[]
  schedulingRuns          SchedulingRun[]

  @@map("tenants")
}

// Per-tenant atomic counters for business document numbers (TO/SH/LD...).
// Incremented via INSERT ... ON CONFLICT DO UPDATE RETURNING (see SequencesService).
model NumberSequence {
  tenantId String @map("tenant_id")
  key      String
  value    Int    @default(0)

  @@id([tenantId, key])
  @@map("number_sequences")
}

enum UserStatus {
  INVITED
  ACTIVE
  DISABLED
}

model User {
  id           String     @id @default(cuid())
  tenantId     String
  email        String
  passwordHash String
  firstName    String
  lastName     String
  status       UserStatus @default(ACTIVE)
  // Stable OIDC identifier (ID token "sub"); email is only a first-login fallback.
  oidcSubject  String?
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  tenant                 Tenant            @relation(fields: [tenantId], references: [id])
  roles                  UserRole[]
  refreshTokens          RefreshToken[]
  actionTokens           UserActionToken[]
  auditLogs              AuditLog[]
  notifications          Notification[]
  uploadedDocuments      Document[]
  createdTransportOrders TransportOrder[]
  recordedTrackingEvents TrackingEvent[]
  receivedPods           ProofOfDelivery[]
  agentServiceFor        Agent[]           @relation("AgentServiceUser")
  preferences            UserPreferences?

  @@unique([tenantId, email])
  @@unique([tenantId, oidcSubject])
  @@index([tenantId])
  @@map("users")
}

model UserPreferences {
  id         String   @id @default(cuid())
  userId     String   @unique
  deskLayout Json     @default("{}")
  appearance Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

// Inbound API keys (read-only scopes in v1). Only the SHA-256 hash is stored;
// the prefix is kept for display ("pk_ab12cd34…").
model ApiKey {
  id          String    @id @default(cuid())
  tenantId    String
  name        String
  prefix      String
  keyHash     String    @unique
  scopes      String[]
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdById String?
  createdAt   DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("api_keys")
}

enum UserActionTokenKind {
  INVITATION
  PASSWORD_RESET
  OIDC_EXCHANGE
}

// One-shot tokens for invitation acceptance and password resets (hash at rest).
model UserActionToken {
  id        String              @id @default(cuid())
  userId    String
  kind      UserActionTokenKind
  tokenHash String              @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_action_tokens")
}

// Rotating refresh tokens (only the SHA-256 hash is stored).
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

enum PlatformUserStatus {
  ACTIVE
  DISABLED
}

// Cross-tenant operators (create/suspend tenants). Deliberately has NO relation
// to any tenant-scoped model — the platform plane never mixes with tenant data.
model PlatformUser {
  id            String             @id @default(cuid())
  email         String             @unique
  passwordHash  String
  firstName     String
  lastName      String
  status        PlatformUserStatus @default(ACTIVE)
  lastLoginAt   DateTime?
  // MFA (TOTP). totpSecret encrypted at rest (enc:v1, CryptoService); recovery
  // codes are bcrypt-hashed and single-use (consumed codes are removed).
  totpSecret    String?
  mfaEnabledAt  DateTime?
  recoveryCodes String[]           @default([])
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@map("platform_users")
}

model Role {
  id          String   @id @default(cuid())
  tenantId    String
  key         String
  name        String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  permissions RolePermission[]
  users       UserRole[]

  @@unique([tenantId, key])
  @@index([tenantId])
  @@map("roles")
}

// Platform-wide permission catalog, seeded from packages/shared.
model Permission {
  id          String @id @default(cuid())
  key         String @unique
  module      String
  description String

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

// ============================================================================
// CORE — audit, documents, notifications, integrations, module registry
// ============================================================================

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String
  userId     String?
  action     String // CREATE | UPDATE | DELETE | STATUS_CHANGE | LOGIN
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User?  @relation(fields: [userId], references: [id])

  @@index([tenantId, entityType, entityId])
  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

// Document metadata only — binary storage (S3/local) is referenced by storageKey.
model Document {
  id           String   @id @default(cuid())
  tenantId     String
  entityType   String
  entityId     String
  fileName     String
  mimeType     String
  sizeBytes    Int
  storageKey   String
  uploadedById String?
  createdAt    DateTime @default(now())

  tenant     Tenant @relation(fields: [tenantId], references: [id])
  uploadedBy User?  @relation(fields: [uploadedById], references: [id])

  @@index([tenantId, entityType, entityId])
  @@map("documents")
}

enum NotificationLevel {
  INFO
  WARNING
  CRITICAL
}

model Notification {
  id        String            @id @default(cuid())
  tenantId  String
  // null = tenant-wide notification (e.g. delay alerts); read-by-one = read-for-all (v1)
  userId    String?
  level     NotificationLevel @default(INFO)
  title     String
  body      String
  payload   Json?
  readAt    DateTime?
  createdAt DateTime          @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User?  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, readAt])
  @@map("notifications")
}

enum IntegrationStatus {
  DISABLED
  ENABLED
  ERROR
}

model Integration {
  id        String            @id @default(cuid())
  tenantId  String
  key       String // e.g. "telematics-samsara", "edi-204"
  name      String
  status    IntegrationStatus @default(DISABLED)
  config    Json              @default("{}")
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  tenant     Tenant            @relation(fields: [tenantId], references: [id])
  deliveries WebhookDelivery[]

  @@unique([tenantId, key])
  @@index([tenantId])
  @@map("integrations")
}

enum WebhookDeliveryStatus {
  PENDING
  DELIVERED
  FAILED
}

// Durable outbox for outbound webhooks: retried with backoff until delivered
// or the attempt budget is exhausted.
model WebhookDelivery {
  id            String                @id @default(cuid())
  tenantId      String
  integrationId String
  event         String
  payload       Json
  status        WebhookDeliveryStatus @default(PENDING)
  attempts      Int                   @default(0)
  nextAttemptAt DateTime              @default(now())
  lastError     String?
  deliveredAt   DateTime?
  createdAt     DateTime              @default(now())

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([tenantId, integrationId, createdAt])
  @@map("webhook_deliveries")
}

// Platform module catalog (core, transportation, fleet, ...).
model ModuleDefinition {
  id          String  @id @default(cuid())
  key         String  @unique
  name        String
  description String
  isCore      Boolean @default(false)
  available   Boolean @default(false)

  tenants TenantModule[]

  @@map("module_definitions")
}

// Per-tenant module activation — the heart of the modular platform.
model TenantModule {
  tenantId  String
  moduleId  String
  enabled   Boolean   @default(false)
  settings  Json      @default("{}")
  enabledAt DateTime?

  tenant Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  module ModuleDefinition @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@id([tenantId, moduleId])
  @@map("tenant_modules")
}

// ============================================================================
// TRANSPORTATION — master data
// ============================================================================

model Customer {
  id          String   @id @default(cuid())
  tenantId    String
  code        String
  name        String
  contactName String?
  email       String?
  phone       String?
  notes       String?
  // Customer Portal capability link (module customer-portal must be enabled).
  portalToken String?  @unique
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant           Tenant            @relation(fields: [tenantId], references: [id])
  locations        Location[]
  transportOrders  TransportOrder[]
  rates            Rate[]
  customerInvoices CustomerInvoice[]
  orderTemplates   OrderTemplate[]
  subscriptions    Subscription[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("customers")
}

enum LocationType {
  PLANT
  WAREHOUSE
  DISTRIBUTION_CENTER
  CUSTOMER_SITE
  CARRIER_TERMINAL
  OTHER
}

model Location {
  id           String       @id @default(cuid())
  tenantId     String
  customerId   String?
  code         String
  name         String
  type         LocationType @default(OTHER)
  addressLine1 String
  addressLine2 String?
  city         String
  state        String?
  postalCode   String?
  country      String       @default("CA")
  latitude     Float?
  longitude    Float?
  timezone     String?
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  tenant               Tenant            @relation(fields: [tenantId], references: [id])
  customer             Customer?         @relation(fields: [customerId], references: [id])
  originOrders         TransportOrder[]  @relation("OrderOrigin")
  destinationOrders    TransportOrder[]  @relation("OrderDestination")
  originShipments      Shipment[]        @relation("ShipmentOrigin")
  destinationShipments Shipment[]        @relation("ShipmentDestination")
  stops                Stop[]
  laneOrigins          Lane[]            @relation("LaneOrigin")
  laneDestinations     Lane[]            @relation("LaneDestination")
  bins                 Bin[]
  receipts             Receipt[]
  pickOrders           PickOrder[]
  yardSpots            YardSpot[]
  yardVisits           YardVisit[]
  dockAppointments     DockAppointment[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("locations")
}

enum CarrierStatus {
  ACTIVE
  INACTIVE
}

model Carrier {
  id          String        @id @default(cuid())
  tenantId    String
  code        String
  name        String
  scacCode    String?
  mcNumber    String?
  dotNumber   String?
  contactName String?
  email       String?
  phone       String?
  status      CarrierStatus @default(ACTIVE)
  // Carrier Portal capability link (module carrier-portal must be enabled).
  portalToken String?       @unique
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  tenant                  Tenant                   @relation(fields: [tenantId], references: [id])
  drivers                 Driver[]
  vehicles                Vehicle[]
  trailers                Trailer[]
  loads                   Load[]
  rates                   Rate[]
  tenders                 Tender[]
  lanePreferences         LaneCarrierPreference[]
  invoices                Invoice[]
  incomingCarrierInvoices IncomingCarrierInvoice[]
  yardVisits              YardVisit[]
  dockAppointments        DockAppointment[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("carriers")
}

enum DriverStatus {
  ACTIVE
  INACTIVE
}

model Driver {
  id            String       @id @default(cuid())
  tenantId      String
  carrierId     String? // null = internal fleet driver
  firstName     String
  lastName      String
  licenseNumber String?
  phone         String?
  email         String?
  status        DriverStatus @default(ACTIVE)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  tenant  Tenant   @relation(fields: [tenantId], references: [id])
  carrier Carrier? @relation(fields: [carrierId], references: [id])
  loads   Load[]
  inspectionReports InspectionReport[]

  @@index([tenantId])
  @@map("drivers")
}

enum AssetStatus {
  AVAILABLE
  IN_SERVICE
  MAINTENANCE
  RETIRED
}

enum VehicleType {
  TRACTOR
  STRAIGHT_TRUCK
  VAN
  OTHER
}

model Vehicle {
  id         String      @id @default(cuid())
  tenantId   String
  carrierId  String?
  unitNumber String
  type       VehicleType @default(TRACTOR)
  make       String?
  model      String?
  year       Int?
  vin        String?
  plate      String?
  status     AssetStatus @default(AVAILABLE)
  fixedAssetId String?   // soft FK to billing FixedAsset (book value display; ownership checked in service)
  customData Json?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  tenant               Tenant                @relation(fields: [tenantId], references: [id])
  carrier              Carrier?              @relation(fields: [carrierId], references: [id])
  loads                Load[]
  maintenanceOrders    MaintenanceOrder[]
  maintenanceSchedules MaintenanceSchedule[]
  odometerReadings     OdometerReading[]
  fuelLogs             FuelLog[]
  inspectionReports    InspectionReport[]

  @@unique([tenantId, unitNumber])
  @@index([tenantId])
  @@map("vehicles")
}

enum TrailerType {
  DRY_VAN
  REEFER
  FLATBED
  TANKER
  OTHER
}

model Trailer {
  id               String      @id @default(cuid())
  tenantId         String
  carrierId        String?
  unitNumber       String
  type             TrailerType @default(DRY_VAN)
  capacityWeightKg Float?
  capacityVolumeM3 Float?
  capacityPallets  Int?
  plate            String?
  status           AssetStatus @default(AVAILABLE)
  fixedAssetId     String?     // soft FK to billing FixedAsset (book value display; ownership checked in service)
  customData       Json?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  tenant               Tenant                @relation(fields: [tenantId], references: [id])
  carrier              Carrier?              @relation(fields: [carrierId], references: [id])
  loads                Load[]
  maintenanceOrders    MaintenanceOrder[]
  maintenanceSchedules MaintenanceSchedule[]
  yardVisits           YardVisit[]
  odometerReadings     OdometerReading[]
  fuelLogs             FuelLog[]
  inspectionReports    InspectionReport[]

  @@unique([tenantId, unitNumber])
  @@index([tenantId])
  @@map("trailers")
}

// ============================================================================
// FLEET — maintenance & compliance (mirror of @pulsar/shared fleet enums)
// ============================================================================

enum MaintenanceType {
  PREVENTIVE
  REPAIR
  INSPECTION
}

enum MaintenanceOrderStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ComplianceSubject {
  VEHICLE
  TRAILER
  DRIVER
}

enum ComplianceDocType {
  REGISTRATION
  INSURANCE
  INSPECTION
  LICENSE
  MEDICAL
  OTHER
}

// ============================================================================
// TRANSPORTATION — orders, planning, execution
// Workflow: TransportOrder → Shipment → Load → Route → Dispatch → In Transit
//           → Delivered → Closed (see packages/shared/src/workflows)
// ============================================================================

enum TransportOrderStatus {
  DRAFT
  CONFIRMED
  PLANNED
  IN_EXECUTION
  COMPLETED
  CLOSED
  CANCELLED
}

// Customer demand — the commercial request to move freight (OTM "order release").
model TransportOrder {
  id                     String               @id @default(cuid())
  tenantId               String
  orderNumber            String
  customerId             String
  customerReference      String?
  status                 TransportOrderStatus @default(DRAFT)
  mode                   TransportMode        @default(FTL)
  originLocationId       String
  destinationLocationId  String
  requestedPickupEarly   DateTime?
  requestedPickupLate    DateTime?
  requestedDeliveryEarly DateTime?
  requestedDeliveryLate  DateTime?
  totalWeightKg          Float?
  totalVolumeM3          Float?
  palletCount            Int?
  notes                  String?
  customData             Json?
  createdById            String?
  // Fulfillment bridge (CRM → TMS). Null for ordinary transport orders. When a
  // transport order is created from a CRM sales order, these carry the source
  // link. `sourceFulfillmentKey` defaults to "primary" and lets one sales order
  // fan out to several transport orders later (partial shipments). The compound
  // unique below makes the CRM-origin creation idempotent; NULLs are distinct in
  // Postgres, so ordinary transport orders (both null) never collide.
  sourceSalesOrderId     String?
  sourceFulfillmentKey   String?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  tenant              Tenant               @relation(fields: [tenantId], references: [id])
  customer            Customer             @relation(fields: [customerId], references: [id])
  originLocation      Location             @relation("OrderOrigin", fields: [originLocationId], references: [id])
  destinationLocation Location             @relation("OrderDestination", fields: [destinationLocationId], references: [id])
  createdBy           User?                @relation(fields: [createdById], references: [id])
  sourceSalesOrder    SalesOrder?          @relation("SalesOrderFulfillment", fields: [sourceSalesOrderId], references: [id])
  shipments           Shipment[]
  customerInvoiceLine CustomerInvoiceLine?

  @@unique([tenantId, orderNumber])
  @@unique([tenantId, sourceSalesOrderId, sourceFulfillmentKey], name: "to_source_fulfillment")
  @@index([tenantId, status])
  @@index([tenantId, customerId])
  @@index([tenantId, sourceSalesOrderId])
  @@map("transport_orders")
}

model OrderTemplate {
  id                    String         @id @default(cuid())
  tenantId              String
  customerId            String
  name                  String
  originLocationId      String?
  destinationLocationId String?
  mode                  TransportMode?
  totalWeightKg         Float?
  totalVolumeM3         Float?
  palletCount           Int?
  notes                 String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])

  @@index([tenantId, customerId])
  @@map("order_templates")
}

// Tenant-configurable automation rule (Module I): "Quand <event> [Si <conditions>] Alors créer une tâche".
// match (ALL/ANY), conditions[] and the CREATE_TASK action are validated against @pulsar/shared unions;
// stored as String/Json (no new Prisma enum).
model AutomationRule {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  eventType   String
  enabled     Boolean  @default(true)
  match       String
  conditions  Json
  action      Json
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, eventType, enabled])
  @@map("automation_rules")
}

enum ShipmentStatus {
  PENDING
  PLANNED
  DISPATCHED
  IN_TRANSIT
  DELIVERED
  CLOSED
  CANCELLED
}

// Planning/execution unit derived from an order (SAP TM "freight unit").
model Shipment {
  id                    String         @id @default(cuid())
  tenantId              String
  shipmentNumber        String
  transportOrderId      String
  status                ShipmentStatus @default(PENDING)
  // Public share token: anyone with it can view the read-only tracking page.
  trackingToken         String?        @unique
  originLocationId      String
  destinationLocationId String
  loadId                String?
  weightKg              Float?
  volumeM3              Float?
  palletCount           Int?
  plannedPickupEarly    DateTime?
  plannedPickupLate     DateTime?
  plannedDeliveryEarly  DateTime?
  plannedDeliveryLate   DateTime?
  actualPickupAt        DateTime?
  actualDeliveryAt      DateTime?
  customData            Json?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  tenant              Tenant            @relation(fields: [tenantId], references: [id])
  transportOrder      TransportOrder    @relation(fields: [transportOrderId], references: [id])
  originLocation      Location          @relation("ShipmentOrigin", fields: [originLocationId], references: [id])
  destinationLocation Location          @relation("ShipmentDestination", fields: [destinationLocationId], references: [id])
  load                Load?             @relation(fields: [loadId], references: [id])
  stops               Stop[]
  trackingEvents      TrackingEvent[]
  proofOfDelivery     ProofOfDelivery?
  legs                ShipmentLoadLeg[]
  pickOrders          PickOrder[]
  comments            ShipmentComment[]

  @@unique([tenantId, shipmentNumber])
  @@index([tenantId, status])
  @@index([tenantId, transportOrderId])
  @@map("shipments")
}

model ShipmentComment {
  id         String   @id @default(cuid())
  tenantId   String
  shipmentId String
  authorType String // 'CUSTOMER' | 'STAFF'
  authorId   String? // userId (STAFF) | customerId (CUSTOMER) — internal, never exposed publicly
  authorName String
  body       String
  createdAt  DateTime @default(now())

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([tenantId, shipmentId, createdAt])
  @@map("shipment_comments")
}

enum LoadStatus {
  OPEN
  PLANNED
  TENDERED
  DISPATCHED
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

// Physical consolidation assigned to a carrier/vehicle (SAP TM "freight order").
model Load {
  id            String        @id @default(cuid())
  tenantId      String
  loadNumber    String
  status        LoadStatus    @default(OPEN)
  mode          TransportMode @default(FTL)
  carrierId     String?
  driverId      String?
  vehicleId     String?
  trailerId     String?
  rateId        String?
  // Estimated buy-side cost computed from the assigned rate (see calculateRateCost).
  estimatedCost Decimal?      @db.Decimal(12, 2)
  costCurrency  String?
  // Frozen calculation snapshot (rate as used + inputs + lines). See spec invariants:
  // a COMPLETED load is never recomputed; reconciliation reads this, never recomputes.
  costDetail    Json?
  // Public driver token: grants stop check-in/out + POD capture on this load only.
  driverToken   String?       @unique
  dispatchedAt  DateTime?
  completedAt   DateTime?
  notes         String?
  customData    Json?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  tenant         Tenant            @relation(fields: [tenantId], references: [id])
  carrier        Carrier?          @relation(fields: [carrierId], references: [id])
  driver         Driver?           @relation(fields: [driverId], references: [id])
  vehicle        Vehicle?          @relation(fields: [vehicleId], references: [id])
  trailer        Trailer?          @relation(fields: [trailerId], references: [id])
  rate           Rate?             @relation(fields: [rateId], references: [id])
  shipments      Shipment[]
  route          Route?
  trackingEvents TrackingEvent[]
  tenders        Tender[]
  accessorials   LoadAccessorial[]
  invoiceLine    InvoiceLine?
  legs           ShipmentLoadLeg[]

  @@unique([tenantId, loadNumber])
  @@index([tenantId, status])
  @@map("loads")
}

// Junction shipment×load×sequence — unlocks future multi-leg (audit §3). In v1
// (single-leg) it mirrors Shipment.loadId, written in the SAME transaction: never
// divergent. loadId stays as the "current leg" denormalization for existing readers.
model ShipmentLoadLeg {
  id         String   @id @default(cuid())
  tenantId   String
  shipmentId String
  loadId     String
  sequence   Int      @default(1)
  createdAt  DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  load     Load     @relation(fields: [loadId], references: [id], onDelete: Restrict)

  @@unique([shipmentId, sequence])
  @@unique([shipmentId, loadId])
  @@index([tenantId])
  @@index([loadId])
  @@map("shipment_load_legs")
}

enum TenderStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELLED
}

// Offer sent to a carrier to haul a load. The carrier responds through a
// public tokenized link — no Pulsar account required.
model Tender {
  id            String       @id @default(cuid())
  tenantId      String
  loadId        String
  carrierId     String
  status        TenderStatus @default(PENDING)
  // Part of an automatic sequence: on decline/expiry the next carrier in the
  // lane preference list is tendered automatically.
  isAuto        Boolean      @default(false)
  token         String       @unique
  message       String?
  declineReason String?
  expiresAt     DateTime
  sentAt        DateTime     @default(now())
  respondedAt   DateTime?
  // Frozen offer snapshot taken at send time from Load.estimatedCost/costCurrency.
  // The carrier-facing projection reads THIS, never the live load cost — a later
  // recompute of the load must not change an offer already sent (immutability).
  offeredAmount   Decimal?   @db.Decimal(12, 2)
  offeredCurrency String?

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  load    Load    @relation(fields: [loadId], references: [id], onDelete: Cascade)
  carrier Carrier @relation(fields: [carrierId], references: [id])

  @@index([tenantId, loadId])
  @@index([status, expiresAt])
  @@map("tenders")
}

// Geographic level of a lane endpoint, most → least specific (mirror of @pulsar/shared).
enum LaneEndpointType {
  LOCATION
  CITY
  STATE
  COUNTRY
}

// First-class lane: each endpoint is one level of the geo hierarchy site < city < state < country.
// originKey/destinationKey are normalized matching keys (see packages/shared rating/lane-key.ts);
// the unique below makes strictly identical lanes impossible.
model Lane {
  id                    String           @id @default(cuid())
  tenantId              String
  name                  String?
  originType            LaneEndpointType
  originLocationId      String?
  originCity            String?
  originState           String?
  originCountry         String?
  destinationType       LaneEndpointType
  destinationLocationId String?
  destinationCity       String?
  destinationState      String?
  destinationCountry    String?
  originKey             String
  destinationKey        String
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  tenant              Tenant                  @relation(fields: [tenantId], references: [id])
  // Restrict intentionally: a LOCATION-level lane's originKey embeds the location id —
  // SET NULL would orphan the key. Same policy as every rating-entity reference.
  originLocation      Location?               @relation("LaneOrigin", fields: [originLocationId], references: [id], onDelete: Restrict)
  destinationLocation Location?               @relation("LaneDestination", fields: [destinationLocationId], references: [id], onDelete: Restrict)
  rates               Rate[]
  carrierPreferences  LaneCarrierPreference[]

  @@unique([tenantId, originKey, destinationKey])
  @@index([tenantId])
  @@map("lanes")
}

// Ordered carrier preference per lane (origin → destination pair).
// Drives auto-tendering: rank 1 is offered first, then rank 2 on decline/expiry, etc.
model LaneCarrierPreference {
  id        String @id @default(cuid())
  tenantId  String
  laneId    String
  carrierId String
  rank      Int

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  lane    Lane    @relation(fields: [laneId], references: [id], onDelete: Restrict)
  carrier Carrier @relation(fields: [carrierId], references: [id])

  @@unique([tenantId, laneId, rank], map: "lane_prefs_lane_rank_key")
  @@unique([tenantId, laneId, carrierId], map: "lane_prefs_lane_carrier_key")
  @@map("lane_carrier_preferences")
}

enum DistanceSource {
  MANUAL
  OSRM
  HAVERSINE
}

// Ordered stop sequence for a load.
model Route {
  id                   String          @id @default(cuid())
  tenantId             String
  loadId               String          @unique
  totalDistanceKm      Float?
  estimatedDurationMin Int?
  // Provenance of totalDistanceKm — MANUAL is never overwritten by recomputes.
  distanceSource       DistanceSource?
  // OSRM route geometry (GeoJSON LineString, [lng, lat] order). Display only.
  geometry             Json?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  load   Load   @relation(fields: [loadId], references: [id], onDelete: Cascade)
  stops  Stop[]

  @@index([tenantId])
  @@map("routes")
}

enum StopType {
  PICKUP
  DELIVERY
}

enum StopStatus {
  PENDING
  ARRIVED
  DEPARTED
  COMPLETED
  SKIPPED
}

model Stop {
  id                  String     @id @default(cuid())
  tenantId            String
  routeId             String
  sequence            Int
  type                StopType
  status              StopStatus @default(PENDING)
  locationId          String
  shipmentId          String?
  plannedArrivalEarly DateTime?
  plannedArrivalLate  DateTime?
  plannedDepartureAt  DateTime?
  actualArrivalAt     DateTime?
  actualDepartureAt   DateTime?
  notes               String?

  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  route          Route           @relation(fields: [routeId], references: [id], onDelete: Cascade)
  location       Location        @relation(fields: [locationId], references: [id])
  shipment       Shipment?       @relation(fields: [shipmentId], references: [id])
  trackingEvents TrackingEvent[]

  @@unique([routeId, sequence])
  @@index([tenantId])
  @@map("stops")
}

enum RateType {
  FLAT
  PER_KM
  PER_HUNDREDWEIGHT
  PER_PALLET
  SPOT
}

enum RateStatus {
  DRAFT
  ACTIVE
  EXPIRED
}

// Simple rate offering (buy-side carrier rate or sell-side customer rate).
model Rate {
  id               String         @id @default(cuid())
  tenantId         String
  name             String
  carrierId        String?
  customerId       String?
  laneId           String?
  fuelTableId      String?
  rateType         RateType       @default(FLAT)
  // null = applies to all modes
  mode             TransportMode?
  currency         String         @default("CAD")
  baseAmount       Decimal        @db.Decimal(12, 2)
  fuelSurchargePct Float?
  minCharge        Decimal?       @db.Decimal(12, 2)
  validFrom        DateTime?
  validTo          DateTime?
  status           RateStatus     @default(DRAFT)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  tenant            Tenant                 @relation(fields: [tenantId], references: [id])
  carrier           Carrier?               @relation(fields: [carrierId], references: [id])
  customer          Customer?              @relation(fields: [customerId], references: [id])
  // Restrict intentionally: deleting a lane/fuel table with live rates must fail loudly,
  // never silently detach pricing (see plan phase 7.1, deletion policy).
  lane              Lane?                  @relation(fields: [laneId], references: [id], onDelete: Restrict)
  fuelTable         FuelSurchargeTable?    @relation(fields: [fuelTableId], references: [id], onDelete: Restrict)
  breaks            RateBreak[]
  accessorialPrices RateAccessorialPrice[]
  loads             Load[]

  @@index([tenantId])
  @@index([tenantId, laneId])
  @@map("rates")
}

// Degressive weight bracket of a PER_HUNDREDWEIGHT rate (amount per CWT up to upToKg).
model RateBreak {
  id     String  @id @default(cuid())
  rateId String
  upToKg Float
  amount Decimal @db.Decimal(12, 2)

  rate Rate @relation(fields: [rateId], references: [id], onDelete: Cascade)

  @@unique([rateId, upToKg])
  @@map("rate_breaks")
}

// Pricing unit of an accessorial charge (mirror of @pulsar/shared).
enum AccessorialUnit {
  FLAT
  PER_HOUR
  PER_UNIT
}

// Shipping mode (mirror of @pulsar/shared). Default FTL.
enum TransportMode {
  FTL
  LTL
  PARCEL
}

// Tenant accessorial catalog (tailgate, wait time, residential…).
model Accessorial {
  id        String          @id @default(cuid())
  tenantId  String
  code      String
  name      String
  unit      AccessorialUnit @default(FLAT)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  tenant           Tenant                 @relation(fields: [tenantId], references: [id])
  ratePrices       RateAccessorialPrice[]
  loadAccessorials LoadAccessorial[]

  @@unique([tenantId, code])
  @@map("accessorials")
}

// Price of one accessorial under one rate — lets rate shopping compare carriers like for like.
model RateAccessorialPrice {
  id            String  @id @default(cuid())
  rateId        String
  accessorialId String
  amount        Decimal @db.Decimal(12, 2)

  rate        Rate        @relation(fields: [rateId], references: [id], onDelete: Cascade)
  accessorial Accessorial @relation(fields: [accessorialId], references: [id], onDelete: Restrict)

  @@unique([rateId, accessorialId])
  @@map("rate_accessorial_prices")
}

// Accessorials the planner flagged on a load (quantity forced to 1 for FLAT units).
model LoadAccessorial {
  id            String @id @default(cuid())
  loadId        String
  accessorialId String
  quantity      Float  @default(1)

  load        Load        @relation(fields: [loadId], references: [id], onDelete: Cascade)
  accessorial Accessorial @relation(fields: [accessorialId], references: [id], onDelete: Restrict)

  @@unique([loadId, accessorialId])
  @@map("load_accessorials")
}

// Dated fuel surcharge table; the entry in force at the load's reference date applies.
model FuelSurchargeTable {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant               @relation(fields: [tenantId], references: [id])
  entries FuelSurchargeEntry[]
  rates   Rate[]

  @@index([tenantId])
  @@map("fuel_surcharge_tables")
}

model FuelSurchargeEntry {
  id            String   @id @default(cuid())
  tableId       String
  effectiveFrom DateTime
  pct           Float

  table FuelSurchargeTable @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@unique([tableId, effectiveFrom])
  @@map("fuel_surcharge_entries")
}

enum TrackingEventType {
  CREATED
  PLANNED
  DISPATCHED
  POSITION_UPDATE
  ARRIVED_AT_STOP
  DEPARTED_STOP
  DELAYED
  EXCEPTION
  DELIVERED
  CANCELLED
}

model TrackingEvent {
  id           String            @id @default(cuid())
  tenantId     String
  type         TrackingEventType
  loadId       String?
  shipmentId   String?
  stopId       String?
  message      String?
  latitude     Float?
  longitude    Float?
  payload      Json?
  occurredAt   DateTime          @default(now())
  recordedById String?
  createdAt    DateTime          @default(now())
  /// Race-proof dedup for synthetic events (e.g. 'DELAYED:<stopId>:<deadlineISO>'); null for ordinary events (Postgres allows multiple nulls).
  dedupKey     String?           @unique

  tenant     Tenant    @relation(fields: [tenantId], references: [id])
  load       Load?     @relation(fields: [loadId], references: [id])
  shipment   Shipment? @relation(fields: [shipmentId], references: [id])
  stop       Stop?     @relation(fields: [stopId], references: [id])
  recordedBy User?     @relation(fields: [recordedById], references: [id])

  @@index([tenantId, loadId, occurredAt])
  @@index([tenantId, shipmentId, occurredAt])
  @@map("tracking_events")
}

// Global geocode cache — NOT tenant-scoped: address → coords is not tenant data.
model GeocodeCache {
  id         String   @id @default(cuid())
  addressKey String   @unique
  latitude   Float
  longitude  Float
  provider   String
  createdAt  DateTime @default(now())

  @@map("geocode_cache")
}

// ============================================================================
// BILLING — carrier settlement (buy-side) v1
// ============================================================================

enum InvoiceStatus {
  DRAFT
  APPROVED
  DISPUTED
  PAID
}

enum TaxTemplateType {
  SALES
  PURCHASE
}

enum DisputeReasonCode {
  RATE_MISMATCH
  QUANTITY_MISMATCH
  UNEXPECTED_CHARGE
  DUPLICATE_BILLING
  OTHER
}

enum FreightAuditStatus {
  RECEIVED
  MATCHED
  FLAGGED
  DISPUTED
  RESOLVED
  PAID
}

// Draft invoice grouping the estimated costs of a carrier's completed,
// not-yet-invoiced loads. Reconciled against the carrier's actual invoice
// (tolerance on gross variance), disputed when over, PAID tracked.
model Invoice {
  id            String        @id @default(cuid())
  tenantId      String
  invoiceNumber String
  carrierId     String
  status        InvoiceStatus @default(DRAFT)
  currency      String        @default("CAD")
  totalAmount   Decimal       @db.Decimal(12, 2)
  amountPaid    Decimal       @default(0) @db.Decimal(12, 2)
  taxAmount     Decimal       @default(0) @db.Decimal(12, 2)
  taxTemplateId String?
  taxDetail     Json?
  approvedAt    DateTime?

  // --- Reconciliation against the carrier's actual invoice -------------------
  carrierInvoiceNumber String?
  invoicedTotal        Decimal?           @db.Decimal(12, 2)
  // Net (signed) variance — display; the tolerance rides on varianceGross.
  varianceTotal        Decimal?           @db.Decimal(12, 2)
  varianceGross        Decimal?           @db.Decimal(12, 2)
  // Null until a human qualifies the dispute at resolution time (deliberate).
  disputeReasonCode    DisputeReasonCode?
  disputeNote          String?
  reconciledAt         DateTime?
  paidAt               DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant        @relation(fields: [tenantId], references: [id])
  carrier Carrier       @relation(fields: [carrierId], references: [id])
  lines   InvoiceLine[]

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId, status])
  @@map("invoices")
}

model InvoiceLine {
  id             String   @id @default(cuid())
  invoiceId      String
  // One line per load; the unique constraint prevents double-billing a load.
  loadId         String   @unique
  description    String
  amount         Decimal  @db.Decimal(12, 2)
  invoicedAmount Decimal? @db.Decimal(12, 2)
  variance       Decimal? @db.Decimal(12, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  load    Load    @relation(fields: [loadId], references: [id])

  @@map("invoice_lines")
}

enum CustomerInvoiceStatus {
  DRAFT
  APPROVED
  SENT
  PAID
}

// Customer billing statement (sell-side): delivered orders priced with the
// CUSTOMER's rates (rating engine 7.1), one statement per currency encountered.
// Wording: emails/UI say "billing statement" until taxes exist (spec 7.3).
model CustomerInvoice {
  id            String                @id @default(cuid())
  tenantId      String
  invoiceNumber String
  customerId    String
  status        CustomerInvoiceStatus @default(DRAFT)
  currency      String                @default("CAD")
  totalAmount   Decimal               @db.Decimal(12, 2)
  amountPaid    Decimal               @default(0) @db.Decimal(12, 2)
  taxAmount     Decimal               @default(0) @db.Decimal(12, 2)
  taxTemplateId String?
  taxDetail     Json?
  approvedAt    DateTime?
  sentAt        DateTime?
  paidAt        DateTime?
  customData    Json?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  tenant   Tenant                @relation(fields: [tenantId], references: [id])
  customer Customer              @relation(fields: [customerId], references: [id])
  lines    CustomerInvoiceLine[]

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId, status])
  @@index([tenantId, customerId])
  @@map("customer_invoices")
}

model CustomerInvoiceLine {
  id                String   @id @default(cuid())
  customerInvoiceId String
  // One line per order; the unique prevents double-billing an order. Freed by
  // deleting a DRAFT statement (cascade) — the only escape path by design.
  // Nullable to support free (non-order) invoice lines.
  transportOrderId  String?  @unique
  description       String
  amount            Decimal  @db.Decimal(12, 2)
  // Frozen sell-side snapshot (customer rate as used + inputs + lines), same
  // self-contained structure as Load.costDetail. Never recomputed once APPROVED.
  // Nullable for free lines that have no rate snapshot.
  priceDetail       Json?
  // Free-line fields (null on order-linked lines)
  source            String?
  quantity          Decimal?
  unitPrice         Decimal?
  salesOrderLineId  String?

  customerInvoice CustomerInvoice @relation(fields: [customerInvoiceId], references: [id], onDelete: Cascade)
  transportOrder  TransportOrder? @relation(fields: [transportOrderId], references: [id], onDelete: Restrict)

  @@map("customer_invoice_lines")
}

model IncomingCarrierInvoice {
  id                   String             @id @default(cuid())
  tenantId             String
  carrierId            String
  carrierInvoiceNumber String
  currency             String             @default("CAD")
  chargedTotal         Decimal            @db.Decimal(12, 2)
  receivedAt           DateTime           @default(now())
  status               FreightAuditStatus @default(RECEIVED)
  matchedTotal         Decimal?           @db.Decimal(12, 2)
  varianceTotal        Decimal?           @db.Decimal(12, 2)
  varianceGross        Decimal?           @db.Decimal(12, 2)
  recoveredAmount      Decimal            @default(0) @db.Decimal(12, 2)
  resolution           String?
  disputeReasonCode    String?
  disputeNote          String?
  auditedAt            DateTime?
  resolvedAt           DateTime?
  paidAt               DateTime?
  sourceRef            String             @default("manual")
  disputedByAgentId    String?
  createdById          String?
  customData           Json?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  tenant  Tenant                @relation(fields: [tenantId], references: [id])
  carrier Carrier               @relation(fields: [carrierId], references: [id])
  lines   IncomingInvoiceLine[]

  @@index([tenantId, status])
  @@map("incoming_carrier_invoices")
}

model IncomingInvoiceLine {
  id             String   @id @default(cuid())
  invoiceId      String
  lineRef        String
  description    String?
  chargedAmount  Decimal  @db.Decimal(12, 2)
  matchedLoadId  String?
  expectedAmount Decimal? @db.Decimal(12, 2)
  variance       Decimal? @db.Decimal(12, 2)

  invoice IncomingCarrierInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("incoming_invoice_lines")
}

model ProofOfDelivery {
  id                  String   @id @default(cuid())
  tenantId            String
  shipmentId          String   @unique
  signedByName        String?
  signedAt            DateTime
  notes               String?
  // Signature image / photos are stored as Documents (entityType = "proof-of-delivery").
  signatureDocumentId String?
  receivedById        String?
  createdAt           DateTime @default(now())

  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  shipment   Shipment @relation(fields: [shipmentId], references: [id])
  receivedBy User?    @relation(fields: [receivedById], references: [id])

  @@index([tenantId])
  @@map("proof_of_deliveries")
}

// ---------------------------------------------------------------------------
// Phase 11 — Agent governance (mirrored enums in packages/shared/src/agents/risk.ts)
// ---------------------------------------------------------------------------

enum AgentStatus {
  ACTIVE
  PAUSED
  REVOKED
}

enum AgentAutonomy {
  PROPOSE
  ACT_LOW
  AUTONOMOUS
}

enum RiskTier {
  READ
  LOW
  MUTATING
  SENSITIVE
}

enum ProposalStatus {
  PENDING
  APPROVED
  REJECTED
  EXECUTED
  FAILED
}

enum AgentRunTrigger {
  EVENT
  CRON
  MANUAL
}

enum AgentRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
  KILLED
}

model Agent {
  id               String        @id @default(cuid())
  tenantId         String
  name             String
  description      String?
  permissions      String[]
  caps             Json          @default("{}")
  prefix           String
  secretHash       String        @unique
  serviceUserId    String
  status           AgentStatus   @default(ACTIVE)
  persona          String?
  role             String?
  model            String?
  autonomyLevel    AgentAutonomy @default(PROPOSE)
  avatar           String?
  lastUsedAt       DateTime?
  lastSeenAt       DateTime?
  lastRunAt        DateTime?
  breakerTrippedAt DateTime?
  createdById      String?
  createdAt        DateTime      @default(now())
  revokedAt        DateTime?

  tenant        Tenant              @relation(fields: [tenantId], references: [id])
  serviceUser   User                @relation("AgentServiceUser", fields: [serviceUserId], references: [id])
  proposals     ProposedAction[]
  conversations AgentConversation[]
  runs          AgentRun[]

  @@index([tenantId])
  @@map("agents")
}

model AgentConversation {
  id              String   @id @default(cuid())
  tenantId        String
  agentId         String
  userId          String
  hermesSessionId String?
  title           String?
  createdAt       DateTime @default(now())

  tenant   Tenant         @relation(fields: [tenantId], references: [id])
  agent    Agent          @relation(fields: [agentId], references: [id])
  messages AgentMessage[]

  @@index([tenantId, agentId])
  @@map("agent_conversations")
}

model AgentMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String
  content        String
  proposalId     String?
  createdAt      DateTime @default(now())

  conversation AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("agent_messages")
}

model ProposedAction {
  id             String         @id @default(cuid())
  tenantId       String
  agentId        String
  triggeredByRef String?
  tool           String
  argsJson       Json
  riskTier       RiskTier
  status         ProposalStatus @default(PENDING)
  autoApproved   Boolean        @default(false)
  idempotencyKey String
  decidedById    String?
  decidedAt      DateTime?
  resultJson     Json?
  proposedAt     DateTime       @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  agent  Agent  @relation(fields: [agentId], references: [id])

  @@unique([agentId, idempotencyKey])
  @@index([tenantId, status])
  @@map("proposed_actions")
}

model AgentRuntimeConfig {
  id              String    @id @default(cuid())
  tenantId        String    @unique
  provider        String
  authMode        String
  apiKeyEnc       String?
  defaultModel    String?
  baseUrl         String?
  connectedAt     DateTime?
  lastTestAt      DateTime?
  lastTestOk      Boolean?
  // Cache of the provider's available models, captured on the last successful
  // connection test: [{ value: "<provider:model>", label: "<name>" }]. Populates
  // the model dropdown in agent create/edit (no free-text typos → no 404s).
  availableModels Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("agent_runtime_configs")
}

model AgentRun {
  id                  String          @id @default(cuid())
  tenantId            String
  agentId             String
  trigger             AgentRunTrigger
  taskId              String?
  triggeredByRef      String?
  status              AgentRunStatus  @default(QUEUED)
  attempt             Int             @default(1)
  startedAt           DateTime?
  finishedAt          DateTime?
  error               String?
  proposedActionCount Int             @default(0)
  model               String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  agent  Agent  @relation(fields: [agentId], references: [id])

  @@index([tenantId, agentId, createdAt])
  @@index([tenantId, status])
  @@map("agent_runs")
}

// ---------------------------------------------------------------------------
// Phase 12 — Operating Workbench (mirrored enums in packages/shared/src/enums/operating.ts)
// ---------------------------------------------------------------------------

enum OperationalTaskType {
  EXCEPTION
}

enum OperationalTaskStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  DISMISSED
}

enum TaskAssigneeType {
  UNASSIGNED
  HUMAN
  AGENT
}

enum DomainEventStatus {
  PENDING
  PROCESSED
  FAILED
}

// Durable domain-event outbox: mirrors WebhookDelivery pattern for internal
// event processing. Consumed by the workbench runner to generate operational tasks.
model DomainEvent {
  id             String            @id @default(cuid())
  tenantId       String
  type           String
  subjectType    String?
  subjectId      String?
  payload        Json
  status         DomainEventStatus @default(PENDING)
  attempts       Int               @default(0)
  lastError      String?
  processedAt    DateTime?
  reactionRuleId String?
  createdAt      DateTime          @default(now())

  @@index([status, createdAt])
  @@index([tenantId, type, createdAt])
  @@index([tenantId, subjectType, subjectId])
  @@map("domain_events")
}

// Operational task surface — exceptions and alerts surfaced to human dispatchers
// or agents. The (tenantId, dedupKey) unique constraint enforces idempotent creation.
model OperationalTask {
  id              String                @id @default(cuid())
  tenantId        String
  type            OperationalTaskType
  category        String
  status          OperationalTaskStatus @default(OPEN)
  severity        NotificationLevel     @default(WARNING)
  title           String
  details         Json?
  subjectType     String
  subjectId       String
  assigneeType    TaskAssigneeType      @default(UNASSIGNED)
  assigneeUserId  String?
  assigneeAgentId String?
  dedupKey        String
  sourceEventId   String?
  resolvedById    String?
  resolutionNote  String?
  caseNumber      String?
  slaDueAt        DateTime?
  escalatedAt     DateTime?
  notes           Json?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  resolvedAt      DateTime?

  @@unique([tenantId, dedupKey])
  @@index([tenantId, status, assigneeType])
  @@index([tenantId, assigneeAgentId, status])
  @@index([tenantId, status, slaDueAt])
  @@map("operational_tasks")
}

// ---------------------------------------------------------------------------
// Phase fleet — Maintenance Orders & Compliance Documents
// ---------------------------------------------------------------------------

model MaintenanceOrder {
  id            String                 @id @default(cuid())
  tenantId      String
  vehicleId     String?
  trailerId     String?
  type          MaintenanceType        @default(REPAIR)
  status        MaintenanceOrderStatus @default(OPEN)
  description   String
  odometerKm    Int?
  costAmount    Decimal?               @db.Decimal(12, 2)
  partsCost     Decimal?               @db.Decimal(12, 2)
  laborHours    Decimal?               @db.Decimal(8, 2)
  laborRate     Decimal?               @db.Decimal(10, 2)
  costCurrency  String                 @default("CAD")
  vendor        String?
  dueDate       DateTime?
  dueOdometerKm Int?
  scheduleId    String?
  openedAt      DateTime               @default(now())
  completedAt   DateTime?
  createdById   String?
  customData    Json?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  tenant   Tenant               @relation(fields: [tenantId], references: [id])
  vehicle  Vehicle?             @relation(fields: [vehicleId], references: [id])
  trailer  Trailer?             @relation(fields: [trailerId], references: [id])
  schedule MaintenanceSchedule? @relation(fields: [scheduleId], references: [id])
  parts    MaintenancePart[]

  @@index([tenantId, status])
  @@index([tenantId, vehicleId])
  @@index([tenantId, scheduleId])
  @@map("maintenance_orders")
}

/// A line of parts/materials consumed on a work order. WO total cost is derived as
/// Σ part lineTotal (partsCost) + labour (laborHours × laborRate) — see @pulsar/shared
/// workOrderTotal. lineTotal is persisted = qty × unitCost for cheap aggregation.
model MaintenancePart {
  id                 String   @id @default(cuid())
  tenantId           String
  maintenanceOrderId String
  description        String
  qty                Decimal  @db.Decimal(10, 2)
  unitCost           Decimal  @db.Decimal(12, 2)
  lineTotal          Decimal  @db.Decimal(12, 2)
  createdAt          DateTime @default(now())

  tenant Tenant           @relation(fields: [tenantId], references: [id])
  order  MaintenanceOrder @relation(fields: [maintenanceOrderId], references: [id], onDelete: Cascade)

  @@index([tenantId, maintenanceOrderId])
  @@map("maintenance_parts")
}

enum OdometerSource {
  MANUAL
  WORK_ORDER
  FUEL_LOG
}

/// Append-only odometer history per asset (vehicle XOR trailer). Drives cost/km and
/// utilisation KPIs. Never the source of asset status (rule 32 preserved).
model OdometerReading {
  id        String         @id @default(cuid())
  tenantId  String
  vehicleId String?
  trailerId String?
  readingKm Int
  readAt    DateTime       @default(now())
  source    OdometerSource @default(MANUAL)
  note      String?
  createdById String?
  createdAt DateTime       @default(now())

  tenant  Tenant   @relation(fields: [tenantId], references: [id])
  vehicle Vehicle? @relation(fields: [vehicleId], references: [id])
  trailer Trailer? @relation(fields: [trailerId], references: [id])

  @@index([tenantId, vehicleId, readAt])
  @@index([tenantId, trailerId, readAt])
  @@map("odometer_readings")
}

enum FuelUnit {
  L
  GAL
  KWH
}

/// Fuel / energy purchase per asset. Efficiency (L/100km) and cost/km are derived at
/// read time from the surrounding odometer window — never persisted.
model FuelLog {
  id          String   @id @default(cuid())
  tenantId    String
  vehicleId   String?
  trailerId   String?
  filledAt    DateTime @default(now())
  volume      Decimal  @db.Decimal(12, 3)
  unit        FuelUnit @default(L)
  totalCost   Decimal  @db.Decimal(12, 2)
  currency    String   @default("CAD")
  odometerKm  Int?
  location    String?
  note        String?
  createdById String?
  createdAt   DateTime @default(now())

  tenant  Tenant   @relation(fields: [tenantId], references: [id])
  vehicle Vehicle? @relation(fields: [vehicleId], references: [id])
  trailer Trailer? @relation(fields: [trailerId], references: [id])

  @@index([tenantId, vehicleId, filledAt])
  @@index([tenantId, trailerId, filledAt])
  @@map("fuel_logs")
}

enum InspectionSubject {
  VEHICLE
  TRAILER
  DRIVER
  ANY
}

enum InspectionStatus {
  DRAFT
  PASSED
  FAILED
}

enum InspectionResult {
  PASS
  FAIL
  NA
}

/// Reusable DVIR / inspection checklist template (a named list of items).
model InspectionTemplate {
  id        String                   @id @default(cuid())
  tenantId  String
  name      String
  appliesTo InspectionSubject        @default(ANY)
  isActive  Boolean                  @default(true)
  createdAt DateTime                 @default(now())
  updatedAt DateTime                 @updatedAt

  tenant  Tenant                     @relation(fields: [tenantId], references: [id])
  items   InspectionTemplateItem[]
  reports InspectionReport[]

  @@index([tenantId, isActive])
  @@map("inspection_templates")
}

model InspectionTemplateItem {
  id         String             @id @default(cuid())
  tenantId   String
  templateId String
  label      String
  category   String?
  order      Int                @default(0)

  tenant   Tenant             @relation(fields: [tenantId], references: [id])
  template InspectionTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([tenantId, templateId])
  @@map("inspection_template_items")
}

/// A performed inspection (DVIR). Status is derived from item results at submit
/// (any FAIL ⇒ FAILED) via @pulsar/shared deriveInspectionStatus; transitions via
/// canTransitionInspection (rule 2). Targets one subject (vehicle/trailer/driver).
model InspectionReport {
  id            String           @id @default(cuid())
  tenantId      String
  templateId    String
  vehicleId     String?
  trailerId     String?
  driverId      String?
  status        InspectionStatus @default(DRAFT)
  inspectorName String?
  odometerKm    Int?
  note          String?
  inspectedAt   DateTime         @default(now())
  submittedAt   DateTime?
  createdById   String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  tenant   Tenant             @relation(fields: [tenantId], references: [id])
  template InspectionTemplate @relation(fields: [templateId], references: [id])
  vehicle  Vehicle?           @relation(fields: [vehicleId], references: [id])
  trailer  Trailer?           @relation(fields: [trailerId], references: [id])
  driver   Driver?            @relation(fields: [driverId], references: [id])
  items    InspectionItem[]

  @@index([tenantId, status])
  @@index([tenantId, vehicleId])
  @@index([tenantId, trailerId])
  @@map("inspection_reports")
}

model InspectionItem {
  id       String           @id @default(cuid())
  tenantId String
  reportId String
  label    String
  result   InspectionResult @default(NA)
  note     String?

  tenant Tenant           @relation(fields: [tenantId], references: [id])
  report InspectionReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([tenantId, reportId])
  @@map("inspection_items")
}

/// Preventive-maintenance plan: an interval (days and/or km) per asset. The cron
/// computes due/overdue from the anchor; completing a linked work order advances
/// the anchor so the cycle continues. Asset status is never derived from this.
model MaintenanceSchedule {
  id               String          @id @default(cuid())
  tenantId         String
  vehicleId        String?
  trailerId        String?
  name             String
  type             MaintenanceType @default(PREVENTIVE)
  intervalDays     Int?
  intervalKm       Int?
  anchorDate       DateTime        @default(now())
  anchorOdometerKm Int?
  leadDays         Int             @default(7)
  isActive         Boolean         @default(true)
  createdById      String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  tenant  Tenant             @relation(fields: [tenantId], references: [id])
  vehicle Vehicle?           @relation(fields: [vehicleId], references: [id])
  trailer Trailer?           @relation(fields: [trailerId], references: [id])
  orders  MaintenanceOrder[]

  @@index([tenantId, isActive])
  @@index([tenantId, vehicleId])
  @@index([tenantId, trailerId])
  @@map("maintenance_schedules")
}

model ComplianceDocument {
  id          String            @id @default(cuid())
  tenantId    String
  subjectType ComplianceSubject
  subjectId   String
  docType     ComplianceDocType
  reference   String?
  issuedAt    DateTime?
  expiresAt   DateTime
  documentId  String?
  notes       String?
  createdById String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, subjectType, subjectId])
  @@index([tenantId, expiresAt])
  @@map("compliance_documents")
}

// ============================================================================
// TRANSPORTATION — custom field definitions (mirror of @pulsar/shared)
// ============================================================================

enum CustomFieldEntity {
  TRANSPORT_ORDER
  SHIPMENT
  LOAD
  INCOMING_CARRIER_INVOICE
  CUSTOMER_INVOICE
  RECEIPT
  PICK_ORDER
  YARD_VISIT
  DOCK_APPOINTMENT
  VEHICLE
  TRAILER
  MAINTENANCE_ORDER
  RFP
  CRM_COMPANY
  CRM_CONTACT
  CRM_DEAL
}

enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  BOOLEAN
  SELECT
}

model CustomFieldDefinition {
  id         String            @id @default(cuid())
  tenantId   String
  module     String
  entityType CustomFieldEntity
  key        String
  label      String
  type       CustomFieldType
  options    Json?
  required   Boolean           @default(false)
  showInList Boolean           @default(false)
  sortOrder  Int               @default(0)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@unique([tenantId, module, entityType, key])
  @@index([tenantId, module, entityType])
  @@map("custom_field_definitions")
}

enum StockMovementType {
  RECEIPT
  MOVE
  PICK
  ADJUSTMENT
}

enum BinKind {
  RECEIVING
  STORAGE
  SHIPPING
}

enum ReceiptStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum PickOrderStatus {
  OPEN
  PICKED
  COMPLETED
  CANCELLED
}

model WmsItem {
  id           String   @id @default(cuid())
  tenantId     String
  sku          String
  name         String
  unit         String   @default("EA")
  barcode      String?
  reorderPoint Int?
  reorderQty   Int?
  isActive     Boolean  @default(true)
  createdById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  levels          InventoryLevel[]
  movements       StockMovement[]
  receiptLines    ReceiptLine[]
  pickLines       PickLine[]
  cycleCountLines CycleCountLine[]

  @@unique([tenantId, sku])
  @@index([tenantId])
  @@map("wms_items")
}

enum CycleCountStatus {
  OPEN
  COUNTED
  RECONCILED
  CANCELLED
}

/// Recurring inventory-accuracy loop: snapshot a bin's per-item system qty, record
/// the physical count, then reconcile — variances post ADJUSTMENT movements via
/// InventoryService (rule 33; never below 0).
model CycleCount {
  id           String           @id @default(cuid())
  tenantId     String
  number       String
  binId        String
  status       CycleCountStatus @default(OPEN)
  note         String?
  countedAt    DateTime?
  reconciledAt DateTime?
  createdById  String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  tenant Tenant           @relation(fields: [tenantId], references: [id])
  bin    Bin              @relation(fields: [binId], references: [id])
  lines  CycleCountLine[]

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@index([tenantId, binId])
  @@map("wms_cycle_counts")
}

model CycleCountLine {
  id           String   @id @default(cuid())
  tenantId     String
  cycleCountId String
  itemId       String
  systemQty    Decimal  @db.Decimal(14, 3)
  countedQty   Decimal? @db.Decimal(14, 3)
  createdAt    DateTime @default(now())

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  cycleCount CycleCount @relation(fields: [cycleCountId], references: [id], onDelete: Cascade)
  item       WmsItem    @relation(fields: [itemId], references: [id])

  @@index([tenantId, cycleCountId])
  @@map("wms_cycle_count_lines")
}

model Bin {
  id         String   @id @default(cuid())
  tenantId   String
  locationId String
  code       String
  kind       BinKind  @default(STORAGE)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant        Tenant           @relation(fields: [tenantId], references: [id])
  location      Location         @relation(fields: [locationId], references: [id])
  levels        InventoryLevel[]
  movementsFrom StockMovement[]  @relation("MovementFromBin")
  movementsTo   StockMovement[]  @relation("MovementToBin")
  receiptLines  ReceiptLine[]
  pickLines     PickLine[]
  cycleCounts   CycleCount[]

  @@unique([tenantId, locationId, code])
  @@index([tenantId, locationId])
  @@map("wms_bins")
}

model InventoryLevel {
  id        String   @id @default(cuid())
  tenantId  String
  itemId    String
  binId     String
  qtyOnHand Decimal  @default(0) @db.Decimal(14, 3)
  updatedAt DateTime @updatedAt

  tenant Tenant  @relation(fields: [tenantId], references: [id])
  item   WmsItem @relation(fields: [itemId], references: [id])
  bin    Bin     @relation(fields: [binId], references: [id])

  @@unique([tenantId, itemId, binId])
  @@index([tenantId, itemId])
  @@index([tenantId, binId])
  @@map("wms_inventory_levels")
}

model StockMovement {
  id          String            @id @default(cuid())
  tenantId    String
  type        StockMovementType
  itemId      String
  fromBinId   String?
  toBinId     String?
  qty         Decimal           @db.Decimal(14, 3)
  refType     String?
  refId       String?
  note        String?
  createdById String?
  createdAt   DateTime          @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  item    WmsItem @relation(fields: [itemId], references: [id])
  fromBin Bin?    @relation("MovementFromBin", fields: [fromBinId], references: [id])
  toBin   Bin?    @relation("MovementToBin", fields: [toBinId], references: [id])

  @@index([tenantId, itemId])
  @@index([tenantId, createdAt])
  @@index([tenantId, refType, refId])
  @@map("wms_stock_movements")
}

model Receipt {
  id          String        @id @default(cuid())
  tenantId    String
  number      String
  locationId  String
  status      ReceiptStatus @default(DRAFT)
  reference   String?
  note        String?
  postedAt    DateTime?
  createdById String?
  customData  Json?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  tenant   Tenant        @relation(fields: [tenantId], references: [id])
  location Location      @relation(fields: [locationId], references: [id])
  lines    ReceiptLine[]

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@map("wms_receipts")
}

model ReceiptLine {
  id        String  @id @default(cuid())
  tenantId  String
  receiptId String
  itemId    String
  toBinId   String
  qty       Decimal @db.Decimal(14, 3)

  receipt Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  item    WmsItem @relation(fields: [itemId], references: [id])
  toBin   Bin     @relation(fields: [toBinId], references: [id])

  @@index([tenantId, receiptId])
  @@map("wms_receipt_lines")
}

model PickOrder {
  id          String          @id @default(cuid())
  tenantId    String
  number      String
  locationId  String
  shipmentId  String?
  status      PickOrderStatus @default(OPEN)
  reference   String?
  note        String?
  completedAt DateTime?
  createdById String?
  customData  Json?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  tenant   Tenant     @relation(fields: [tenantId], references: [id])
  location Location   @relation(fields: [locationId], references: [id])
  shipment Shipment?  @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  lines    PickLine[]

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@index([tenantId, shipmentId])
  @@map("wms_pick_orders")
}

model PickLine {
  id          String  @id @default(cuid())
  tenantId    String
  pickOrderId String
  itemId      String
  fromBinId   String
  qty         Decimal @db.Decimal(14, 3)

  pickOrder PickOrder @relation(fields: [pickOrderId], references: [id], onDelete: Cascade)
  item      WmsItem   @relation(fields: [itemId], references: [id])
  fromBin   Bin       @relation(fields: [fromBinId], references: [id])

  @@index([tenantId, pickOrderId])
  @@map("wms_pick_lines")
}

enum YardSpotType {
  DOCK_DOOR
  PARKING
  STAGING
}

enum YardDirection {
  INBOUND
  OUTBOUND
  OTHER
}

enum YardVisitStatus {
  CHECKED_IN
  ASSIGNED
  DEPARTED
  CANCELLED
}

enum DockAppointmentStatus {
  SCHEDULED
  ARRIVED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model YardSpot {
  id         String       @id @default(cuid())
  tenantId   String
  locationId String
  code       String
  type       YardSpotType @default(PARKING)
  posX       Int?
  posY       Int?
  isActive   Boolean      @default(true)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  tenant       Tenant            @relation(fields: [tenantId], references: [id])
  location     Location          @relation(fields: [locationId], references: [id])
  visits       YardVisit[]
  appointments DockAppointment[]
  movesFrom    YardMove[]        @relation("YardMoveFrom")
  movesTo      YardMove[]        @relation("YardMoveTo")

  @@unique([tenantId, locationId, code])
  @@index([tenantId, locationId])
  @@map("yard_spots")
}

model YardVisit {
  id            String          @id @default(cuid())
  tenantId      String
  visitNumber   String
  locationId    String
  trailerId     String?
  trailerRef    String?
  carrierId     String?
  driverName    String?
  direction     YardDirection   @default(OTHER)
  status        YardVisitStatus @default(CHECKED_IN)
  spotId        String?
  appointmentId String?
  checkInAt     DateTime        @default(now())
  checkOutAt    DateTime?
  notes         String?
  createdById   String?
  customData    Json?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  location    Location         @relation(fields: [locationId], references: [id])
  trailer     Trailer?         @relation(fields: [trailerId], references: [id])
  carrier     Carrier?         @relation(fields: [carrierId], references: [id])
  spot        YardSpot?        @relation(fields: [spotId], references: [id])
  appointment DockAppointment? @relation(fields: [appointmentId], references: [id])
  moves       YardMove[]

  @@unique([tenantId, visitNumber])
  @@index([tenantId, status])
  @@index([tenantId, spotId])
  @@map("yard_visits")
}

model YardMove {
  id          String   @id @default(cuid())
  tenantId    String
  visitId     String
  fromSpotId  String?
  toSpotId    String?
  movedAt     DateTime @default(now())
  note        String?
  createdById String?

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  visit    YardVisit @relation(fields: [visitId], references: [id], onDelete: Cascade)
  fromSpot YardSpot? @relation("YardMoveFrom", fields: [fromSpotId], references: [id])
  toSpot   YardSpot? @relation("YardMoveTo", fields: [toSpotId], references: [id])

  @@index([tenantId, visitId])
  @@map("yard_moves")
}

model DockAppointment {
  id                String                @id @default(cuid())
  tenantId          String
  appointmentNumber String
  locationId        String
  spotId            String?
  carrierId         String?
  direction         YardDirection         @default(INBOUND)
  windowStart       DateTime
  windowEnd         DateTime
  reference         String?
  status            DockAppointmentStatus @default(SCHEDULED)
  notes             String?
  createdById       String?
  customData        Json?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  tenant   Tenant      @relation(fields: [tenantId], references: [id])
  location Location    @relation(fields: [locationId], references: [id])
  spot     YardSpot?   @relation(fields: [spotId], references: [id])
  carrier  Carrier?    @relation(fields: [carrierId], references: [id])
  visits   YardVisit[]

  @@unique([tenantId, appointmentNumber])
  @@index([tenantId, status])
  @@index([tenantId, windowStart])
  @@map("dock_appointments")
}

// ============================================================================
// CONNECT — Ingestion / Inbox
// ============================================================================

enum InboundSource {
  CSV
  PDF
  DOCUMENT
  WEBHOOK
}

enum InboundStatus {
  RECEIVED
  PARSED
  IMPORTED
  FAILED
  IGNORED
}

enum ImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ImportRowStatus {
  IMPORTED
  FAILED
}

model InboundMessage {
  id          String        @id @default(cuid())
  tenantId    String
  source      InboundSource
  status      InboundStatus @default(RECEIVED)
  kind        String?
  summary     String
  documentId  String?
  parsed      Json?
  error       String?
  refType     String?
  refId       String?
  createdById String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, status, createdAt])
  @@map("inbound_messages")
}

model ImportBatch {
  id           String       @id @default(cuid())
  tenantId     String
  number       String?
  target       String
  status       ImportStatus @default(PENDING)
  totalRows    Int          @default(0)
  importedRows Int          @default(0)
  failedRows   Int          @default(0)
  mapping      Json
  documentId   String?
  error        String?
  createdById  String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  tenant Tenant      @relation(fields: [tenantId], references: [id])
  rows   ImportRow[]

  @@index([tenantId, status, createdAt])
  @@map("import_batches")
}

model ImportRow {
  id        String          @id @default(cuid())
  tenantId  String
  batchId   String
  rowIndex  Int
  status    ImportRowStatus
  error     String?
  data      Json
  createdAt DateTime        @default(now())

  tenant Tenant      @relation(fields: [tenantId], references: [id])
  batch  ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([tenantId, batchId])
  @@map("import_rows")
}

// ============================================================================
// PROCUREMENT — RFP, Bid Board, Awards (module: procurement)
// ============================================================================

enum RfpStatus {
  DRAFT
  OPEN
  EVALUATION
  AWARDED
  CANCELLED
}

enum BidStatus {
  SUBMITTED
  SHORTLISTED
  ACCEPTED
  REJECTED
}

enum InviteStatus {
  SENT
  RESPONDED
  EXPIRED
}

model Rfp {
  id          String    @id @default(cuid())
  tenantId    String
  rfpNumber   String?
  title       String
  description String?
  status      RfpStatus @default(DRAFT)
  deadline    DateTime?
  createdById String?
  customData  Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant  Tenant      @relation(fields: [tenantId], references: [id])
  lanes   RfpLane[]
  invites RfpInvite[]
  bids    Bid[]

  @@index([tenantId, status, createdAt])
  @@map("rfps")
}

model RfpLane {
  id             String         @id @default(cuid())
  tenantId       String
  rfpId          String
  laneId         String
  mode           TransportMode?
  volumeEstimate Int?

  tenant Tenant @relation(fields: [tenantId], references: [id])
  rfp    Rfp    @relation(fields: [rfpId], references: [id], onDelete: Cascade)
  bids   Bid[]
  award  Award?

  @@index([tenantId, rfpId])
  @@map("rfp_lanes")
}

model RfpInvite {
  id          String       @id @default(cuid())
  tenantId    String
  rfpId       String
  carrierId   String
  token       String       @unique
  status      InviteStatus @default(SENT)
  sentAt      DateTime     @default(now())
  respondedAt DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id])
  rfp    Rfp    @relation(fields: [rfpId], references: [id], onDelete: Cascade)

  @@index([tenantId, rfpId])
  @@map("rfp_invites")
}

model Bid {
  id          String    @id @default(cuid())
  tenantId    String
  rfpId       String
  rfpLaneId   String
  carrierId   String
  rateType    RateType
  amount      Decimal   @db.Decimal(12, 2)
  currency    String    @default("CAD")
  validFrom   DateTime?
  validTo     DateTime?
  transitDays Int?
  notes       String?
  status      BidStatus @default(SUBMITTED)
  submittedAt DateTime  @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  rfp     Rfp     @relation(fields: [rfpId], references: [id], onDelete: Cascade)
  rfpLane RfpLane @relation(fields: [rfpLaneId], references: [id], onDelete: Cascade)

  @@index([tenantId, rfpId])
  @@index([tenantId, rfpLaneId])
  @@map("bids")
}

model Award {
  id          String   @id @default(cuid())
  tenantId    String
  rfpLaneId   String   @unique
  carrierId   String
  bidId       String?
  rateId      String?
  awardedById String?
  awardedAt   DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  rfpLane RfpLane @relation(fields: [rfpLaneId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("awards")
}

// ============================================================================
// CRM — companies, contacts, deals, activities
// ============================================================================

enum CrmCompanyStatus {
  PROSPECT
  ACTIVE
  INACTIVE
}

enum CrmDealStage {
  LEAD
  QUALIFIED
  PROPOSAL
  WON
  LOST
}

enum CrmActivityType {
  NOTE
  CALL
  EMAIL
  MEETING
  TASK
}

model CrmCompany {
  id           String           @id @default(cuid())
  tenantId     String
  name         String
  domain       String?
  industry     String?
  status       CrmCompanyStatus @default(PROSPECT)
  ownerUserId  String?
  customerId   String?
  carrierId    String?
  customData   Json?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  tenant       Tenant           @relation(fields: [tenantId], references: [id])
  contacts     CrmContact[]
  deals        CrmDeal[]
  activities   CrmActivity[]
  salesOrders  SalesOrder[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("crm_companies")
}

model CrmContact {
  id          String          @id @default(cuid())
  tenantId    String
  name        String
  companyId   String?
  title       String?
  email       String?
  phone       String?
  ownerUserId String?
  customData  Json?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  tenant      Tenant          @relation(fields: [tenantId], references: [id])
  company     CrmCompany?     @relation(fields: [companyId], references: [id])
  listMembers CrmListMember[]

  @@index([tenantId])
  @@index([tenantId, companyId])
  @@map("crm_contacts")
}

model CrmDeal {
  id                  String       @id @default(cuid())
  tenantId            String
  title               String
  companyId           String
  stage               CrmDealStage @default(LEAD)
  amount              Decimal?
  currency            String       @default("CAD")
  ownerUserId         String?
  expectedCloseDate   DateTime?
  lastActivityAt      DateTime?
  convertedCustomerId String?
  customData          Json?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  tenant              Tenant       @relation(fields: [tenantId], references: [id])
  company             CrmCompany   @relation(fields: [companyId], references: [id])
  lineItems           CrmDealLineItem[]

  @@index([tenantId])
  @@index([tenantId, stage])
  @@index([tenantId, lastActivityAt])
  @@map("crm_deals")
}

model CrmProduct {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  sku         String?
  description String?
  unitPrice   Decimal  @default(0)
  currency    String   @default("CAD")
  active      Boolean  @default(true)
  customData  Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant    Tenant            @relation(fields: [tenantId], references: [id])
  lineItems CrmDealLineItem[]
  salesOrderLineItems SalesOrderLineItem[]

  @@index([tenantId, active])
  @@map("crm_products")
}

model CrmDealLineItem {
  id          String   @id @default(cuid())
  tenantId    String
  dealId      String
  productId   String?
  name        String
  quantity    Decimal  @default(1)
  unitPrice   Decimal  @default(0)
  discountPct Decimal  @default(0)
  currency    String   @default("CAD")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  deal    CrmDeal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  product CrmProduct? @relation(fields: [productId], references: [id])

  @@index([tenantId, dealId])
  @@map("crm_deal_line_items")
}

model CrmActivity {
  id              String          @id @default(cuid())
  tenantId        String
  type            CrmActivityType
  companyId       String?
  contactId       String?
  dealId          String?
  body            String
  dueAt           DateTime?
  doneAt          DateTime?
  createdByUserId String?
  agentId         String?
  createdAt       DateTime        @default(now())
  tenant          Tenant          @relation(fields: [tenantId], references: [id])
  company         CrmCompany?     @relation(fields: [companyId], references: [id])

  @@index([tenantId])
  @@index([tenantId, dealId])
  @@index([tenantId, companyId])
  @@index([tenantId, type, doneAt])
  @@map("crm_activities")
}

// ============================================================================
// CRM SALES ORDERS
// ============================================================================

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  FULFILLED
  INVOICED
  CANCELLED
}

model SalesOrder {
  id           String           @id @default(cuid())
  tenantId     String
  number       String                       // SO-xxxx via SequencesService
  status       SalesOrderStatus @default(DRAFT)
  companyId    String                        // CRM company (source commerciale)
  customerId   String?                       // Customer lié (si converti)
  dealId       String?                       // deal d'origine
  ownerUserId  String?
  currency     String           @default("CAD")
  totalAmount  Decimal          @default(0)  // recalculé depuis les lignes
  notes        String?
  customData   Json?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  tenant   Tenant       @relation(fields: [tenantId], references: [id])
  company  CrmCompany   @relation(fields: [companyId], references: [id])
  lineItems SalesOrderLineItem[]
  // Fulfillment bridge: a sales order can request 0..N transport orders (rule 9
  // ownership + explicit logistics data supplied at creation, never inferred).
  fulfillmentOrders TransportOrder[] @relation("SalesOrderFulfillment")
  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@index([tenantId, companyId])
  @@map("sales_orders")
}

model SalesOrderLineItem {
  id           String   @id @default(cuid())
  tenantId     String
  salesOrderId String
  productId    String?
  name         String
  quantity     Decimal  @default(1)
  unitPrice    Decimal  @default(0)
  discountPct  Decimal  @default(0)
  currency     String   @default("CAD")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  salesOrder SalesOrder  @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  product    CrmProduct? @relation(fields: [productId], references: [id])
  @@index([tenantId, salesOrderId])
  @@map("sales_order_line_items")
}

// ============================================================================
// CRM LISTS & CAMPAIGNS
// ============================================================================

enum CrmCampaignStatus {
  DRAFT
  SENDING
  SENT
}

model CrmList {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  ownerUserId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant    Tenant          @relation(fields: [tenantId], references: [id])
  members   CrmListMember[]
  campaigns CrmCampaign[]

  @@index([tenantId])
  @@map("crm_lists")
}

model CrmListMember {
  id        String   @id @default(cuid())
  tenantId  String
  listId    String
  contactId String
  createdAt DateTime @default(now())

  list    CrmList    @relation(fields: [listId], references: [id], onDelete: Cascade)
  contact CrmContact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([listId, contactId])
  @@index([tenantId, listId])
  @@map("crm_list_members")
}

model CrmCampaign {
  id          String            @id @default(cuid())
  tenantId    String
  name        String
  listId      String
  subject     String
  html        String
  templateKey String?
  status      CrmCampaignStatus @default(DRAFT)
  recipientCount Int?
  enqueueFailedCount Int @default(0)
  ownerUserId String?
  sentAt      DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  tenant Tenant  @relation(fields: [tenantId], references: [id])
  list   CrmList @relation(fields: [listId], references: [id])

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("crm_campaigns")
}

// ============================================================================
// EMAIL — per-tenant email config, outbox, templates (core email pipeline)
// ============================================================================

// Mirrors EmailDriver / EmailStatus from @pulsar/shared/email (rule 3).
enum EmailDriver {
  SMTP
}

enum EmailStatus {
  QUEUED
  SENDING
  SENT
  FAILED
}

enum EmailThreadStatus {
  UNLINKED
  LINKED
  ARCHIVED
}

enum EmailDirection {
  INBOUND
  OUTBOUND
}

/// Per-tenant SMTP configuration. Password encrypted via CryptoService (never returned in clear).
model TenantEmailConfig {
  id           String      @id @default(cuid())
  tenantId     String      @unique
  driver       EmailDriver @default(SMTP)
  host         String?
  port         Int?
  secure       Boolean     @default(false)
  username     String?
  passwordEnc  String?
  fromName     String?
  fromEmail    String?
  replyTo      String?
  // Inbound (IMAP) — password encrypted via CryptoService, never returned in clear.
  imapHost        String?
  imapPort        Int?
  imapSecure      Boolean   @default(true)
  imapUsername    String?
  imapPasswordEnc String?
  inboundActive   Boolean   @default(false)
  lastPollAt      DateTime?
  lastPollOk      Boolean?
  active       Boolean     @default(true)
  lastTestAt   DateTime?
  lastTestOk   Boolean?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("tenant_email_configs")
}

/// Durable outbox + history for every email sent by the platform.
model EmailMessage {
  id              String      @id @default(cuid())
  tenantId        String
  dedupKey        String?
  toAddresses     String[]
  cc              String[]    @default([])
  subject         String
  html            String
  text            String?
  status          EmailStatus @default(QUEUED)
  attempts        Int         @default(0)
  lastError       String?
  provider        String?
  relatedType     String?
  relatedId       String?
  templateKey     String?
  createdByUserId String?
  agentId         String?
  threadId    String?
  direction   EmailDirection @default(OUTBOUND)
  messageId   String?
  inReplyTo   String?
  references  String?
  fromAddress String?
  sentAt          DateTime?
  nextAttemptAt   DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  tenant      Tenant            @relation(fields: [tenantId], references: [id])
  attachments EmailAttachment[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([status, nextAttemptAt])
  @@index([tenantId, threadId])
  @@index([tenantId, messageId])
  @@unique([tenantId, dedupKey])
  @@map("email_messages")
}

enum CrmSequenceMode {
  SIMULATION
  GOVERNED
}
enum CrmSequenceTrigger {
  MANUAL
  CONTACT_CREATED
}
enum CrmSequenceRunStatus {
  ACTIVE
  PAUSED
  STOPPED
  COMPLETED
  FAILED
}
enum CrmSequenceStepStatus {
  PENDING
  PROPOSED
  QUEUED
  SENT
  SIMULATED
  CANCELLED
  FAILED
}
enum CommunicationConsent {
  UNKNOWN
  GRANTED
  REVOKED
}

/// Frozen on enrollment; editing a scenario never changes a running sequence.
model CrmSequence {
  id String @id @default(cuid())
  tenantId String
  name String
  enabled Boolean @default(false)
  mode CrmSequenceMode @default(SIMULATION)
  trigger CrmSequenceTrigger @default(MANUAL)
  agentId String?
  steps Json
  createdById String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  runs CrmSequenceRun[]
  @@index([tenantId, enabled, trigger])
  @@map("crm_sequences")
}

model CrmSequenceRun {
  id String @id @default(cuid())
  tenantId String
  sequenceId String
  contactId String
  email String
  mode CrmSequenceMode
  agentId String?
  status CrmSequenceRunStatus @default(ACTIVE)
  reason String?
  createdById String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sequence CrmSequence @relation(fields: [sequenceId], references: [id], onDelete: Restrict)
  steps CrmSequenceStepRun[]
  @@unique([tenantId, sequenceId, contactId])
  @@index([tenantId, status])
  @@index([tenantId, contactId])
  @@map("crm_sequence_runs")
}

model CrmSequenceStepRun {
  id String @id @default(cuid())
  tenantId String
  runId String
  position Int
  delayMinutes Int
  subject String
  body String
  status CrmSequenceStepStatus @default(PENDING)
  dueAt DateTime?
  proposalId String?
  emailId String?
  detail String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  run CrmSequenceRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  @@unique([tenantId, runId, position])
  @@index([tenantId, status, dueAt])
  @@map("crm_sequence_step_runs")
}

/// Address-bound: changing a contact's address does not transfer consent.
model CrmEmailPreference {
  id String @id @default(cuid())
  tenantId String
  email String
  consent CommunicationConsent @default(UNKNOWN)
  source String?
  unsubscribeToken String @unique
  updatedById String?
  updatedAt DateTime @updatedAt
  @@unique([tenantId, email])
  @@map("crm_email_preferences")
}

/// Conversation thread grouping inbound + outbound EmailMessage rows, linked to CRM entities.
model EmailThread {
  id            String            @id @default(cuid())
  tenantId      String
  subject       String
  subjectNorm   String
  contactId     String?
  companyId     String?
  dealId        String?
  status        EmailThreadStatus @default(UNLINKED)
  lastMessageAt DateTime
  messageCount  Int               @default(0)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, status, lastMessageAt])
  @@index([tenantId, contactId])
  @@index([tenantId, dealId])
  @@map("email_threads")
}

/// Email attachment: soft FK to Document (no Prisma relation — documentId is stored as a string).
model EmailAttachment {
  id             String @id @default(cuid())
  tenantId       String
  emailMessageId String
  documentId     String
  filename       String

  emailMessage EmailMessage @relation(fields: [emailMessageId], references: [id], onDelete: Cascade)

  @@index([tenantId, emailMessageId])
  @@map("email_attachments")
}

/// Reusable email templates with Handlebars-style {{variable}} placeholders.
model EmailTemplate {
  id        String   @id @default(cuid())
  tenantId  String
  key       String
  name      String
  subject   String
  html      String
  category  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, key])
  @@index([tenantId])
  @@map("email_templates")
}

// ---------------------------------------------------------------------------
// Cross-module automation — reaction execution ledger
// ---------------------------------------------------------------------------

/// Idempotency ledger: one row per (tenant, event, rule) pair.
/// Prevents double-execution when an event is reprocessed.
model ReactionExecution {
  id        String   @id @default(cuid())
  tenantId  String
  eventId   String
  ruleId    String
  action    String
  status    String // 'EXECUTED' | 'FAILED'
  error     String?
  createdAt DateTime @default(now())

  @@unique([tenantId, eventId, ruleId])
  @@index([tenantId, createdAt])
  @@map("reaction_executions")
}

// ===========================================================================
// Manufacturing / APS (sub-project 2). Master-data owned by Pulsar; projected
// into the vendored APS engine's canonical snapshot by SP3. Enums mirror
// packages/shared/src/enums/manufacturing.ts (rule 3).
// ===========================================================================

enum ManufacturingOrderStatus {
  DRAFT
  RELEASED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ManufacturingOperationStatus {
  PENDING
  SCHEDULED
  IN_PROGRESS
  COMPLETED
}

enum ManufacturingPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum ManufacturingFirmness {
  FIRM
  FORECAST
  TENTATIVE
}

model WorkingCalendar {
  id        String   @id @default(cuid())
  tenantId  String
  code      String
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant      Tenant            @relation(fields: [tenantId], references: [id])
  shifts      WorkCenterShift[]
  workCenters WorkCenter[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("working_calendars")
}

model WorkCenterShift {
  id         String   @id @default(cuid())
  tenantId   String
  calendarId String
  weekday    Int // 0 = Monday … 6 = Sunday
  startTime  String // "HH:MM" local plant time
  endTime    String // "HH:MM" local plant time
  createdAt  DateTime @default(now())

  calendar WorkingCalendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)

  @@index([tenantId, calendarId])
  @@map("work_center_shifts")
}

model WorkCenter {
  id           String   @id @default(cuid())
  tenantId     String
  code         String
  name         String
  calendarId   String
  capabilities String[] @default([])
  efficiency   Float    @default(1)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant   Tenant          @relation(fields: [tenantId], references: [id])
  calendar WorkingCalendar @relation(fields: [calendarId], references: [id])

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("work_centers")
}

model Routing {
  id         String   @id @default(cuid())
  tenantId   String
  code       String
  name       String
  productRef String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant Tenant        @relation(fields: [tenantId], references: [id])
  steps  RoutingStep[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("routings")
}

model RoutingStep {
  id                    String   @id @default(cuid())
  tenantId              String
  routingId             String
  sequence              Int
  name                  String
  durationMinutes       Int
  setupMinutes          Int      @default(0)
  eligibleWorkCenterIds String[] @default([])
  createdAt             DateTime @default(now())

  routing Routing @relation(fields: [routingId], references: [id], onDelete: Cascade)

  @@index([tenantId, routingId])
  @@map("routing_steps")
}

model Bom {
  id         String   @id @default(cuid())
  tenantId   String
  code       String
  name       String
  productRef String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant Tenant    @relation(fields: [tenantId], references: [id])
  lines  BomLine[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("boms")
}

model BomLine {
  id              String   @id @default(cuid())
  tenantId        String
  bomId           String
  materialRef     String
  materialName    String?
  quantityPerUnit Float    @default(1)
  createdAt       DateTime @default(now())

  bom Bom @relation(fields: [bomId], references: [id], onDelete: Cascade)

  @@index([tenantId, bomId])
  @@map("bom_lines")
}

model ManufacturingOrder {
  id          String                   @id @default(cuid())
  tenantId    String
  number      String
  name        String
  productRef  String
  quantity    Int                      @default(1)
  dueDate     DateTime
  releaseDate DateTime
  priority    ManufacturingPriority    @default(NORMAL)
  status      ManufacturingOrderStatus @default(DRAFT)
  firmness    ManufacturingFirmness    @default(FIRM)
  routingId   String?
  bomId       String?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  tenant     Tenant                   @relation(fields: [tenantId], references: [id])
  operations ManufacturingOperation[]

  @@unique([tenantId, number])
  @@index([tenantId])
  @@index([tenantId, status])
  @@map("manufacturing_orders")
}

model ManufacturingOperation {
  id                    String                       @id @default(cuid())
  tenantId              String
  orderId               String
  sequence              Int
  name                  String
  durationMinutes       Int
  setupMinutes          Int                          @default(0)
  eligibleWorkCenterIds String[]                     @default([])
  dependsOn             String[]                     @default([]) // predecessor operation ids; empty ⇒ SP3 derives FS chain from sequence
  status                ManufacturingOperationStatus @default(PENDING)
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt

  order ManufacturingOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([tenantId, orderId])
  @@map("manufacturing_operations")
}

// --- Manufacturing scheduling (sub-project 3) — persisted APS run results ---

model SchedulingRun {
  id              String    @id @default(cuid())
  tenantId        String
  apsScheduleId   String?
  strategy        String
  solverStatus    String
  objectiveValue  Int       @default(0)
  wallTimeMs      Int       @default(0)
  horizonStart    DateTime?
  horizonEnd      DateTime?
  orderCount      Int       @default(0)
  operationCount  Int       @default(0)
  assignmentCount Int       @default(0)
  isBaseline      Boolean   @default(false)
  snapshotHash    String?
  warnings        String[]  @default([])
  diagnostics     Json?
  createdById     String?
  createdAt       DateTime  @default(now())

  tenant      Tenant                            @relation(fields: [tenantId], references: [id])
  assignments ScheduledManufacturingOperation[]

  @@index([tenantId, createdAt])
  @@index([tenantId, isBaseline])
  @@map("scheduling_runs")
}

model ScheduledManufacturingOperation {
  id           String   @id @default(cuid())
  tenantId     String
  runId        String
  operationId  String
  orderId      String
  workCenterId String
  setupStart   DateTime
  start        DateTime
  end          DateTime

  run SchedulingRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([tenantId, runId])
  @@map("scheduled_manufacturing_operations")
}

// ============================================================================
// SITES — landing pages + lead capture (module: sites)
// ============================================================================

// Mirrors LandingPageStatus from @pulsar/shared/sites (rule 3).
enum LandingPageStatus {
  DRAFT
  PUBLISHED
}

model LandingPage {
  id            String            @id @default(cuid())
  tenantId      String
  slug          String                          // public id, globally unique
  title         String
  status        LandingPageStatus @default(DRAFT)
  content       Json                            // ordered blocks
  captureListId String?                         // optional CrmList to add leads to
  publishedAt   DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  tenant      Tenant                  @relation(fields: [tenantId], references: [id])
  submissions LandingPageSubmission[]

  @@unique([slug])
  @@index([tenantId, status])
  @@map("landing_pages")
}

model LandingPageSubmission {
  id            String   @id @default(cuid())
  tenantId      String
  landingPageId String
  data          Json                            // raw submitted fields
  contactId     String?                         // matched/created CrmContact (if CRM active)
  createdAt     DateTime @default(now())

  page LandingPage @relation(fields: [landingPageId], references: [id], onDelete: Cascade)

  @@index([tenantId, landingPageId])
  @@map("landing_page_submissions")
}

// ============================================================================
// BILLING — General Ledger (chart of accounts + double-entry journal)
// ============================================================================

// Mirrors DepreciationMethod / FixedAssetStatus from @pulsar/shared/billing/assets (rule 3).
enum DepreciationMethod {
  STRAIGHT_LINE
}

enum FixedAssetStatus {
  DRAFT
  ACTIVE
  DISPOSED
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

enum SubscriptionInterval {
  WEEKLY
  MONTHLY
  YEARLY
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum PaymentType {
  RECEIVE
  PAY
}

enum PaymentStatus {
  DRAFT
  SUBMITTED
  CANCELLED
}

enum PaymentPartyType {
  CUSTOMER
  CARRIER
}

enum PaymentTargetType {
  CUSTOMER_INVOICE
  CARRIER_INVOICE
}

enum BankTxnStatus {
  UNRECONCILED
  RECONCILED
}

model ChartOfAccount {
  id        String      @id @default(cuid())
  tenantId  String
  code      String
  name      String
  type      AccountType
  active    Boolean     @default(true)
  createdAt DateTime    @default(now())

  tenant Tenant        @relation(fields: [tenantId], references: [id])
  lines  JournalLine[]

  @@unique([tenantId, code])
  @@index([tenantId, type])
  @@map("chart_of_accounts")
}

model JournalEntry {
  id          String   @id @default(cuid())
  tenantId    String
  date        DateTime
  memo        String?
  sourceType  String?
  sourceId    String?
  sourceKind  String?
  createdById String?
  createdAt   DateTime @default(now())

  tenant Tenant        @relation(fields: [tenantId], references: [id])
  lines  JournalLine[]

  @@index([tenantId, date])
  @@unique([tenantId, sourceType, sourceId, sourceKind])
  @@map("journal_entries")
}

model JournalLine {
  id             String   @id @default(cuid())
  tenantId       String
  journalEntryId String
  accountId      String
  debit          Decimal  @default(0)
  credit         Decimal  @default(0)
  memo           String?

  entry   JournalEntry   @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account ChartOfAccount @relation(fields: [accountId], references: [id])

  @@index([tenantId, accountId])
  @@index([tenantId, journalEntryId])
  @@map("journal_lines")
}

// ============================================================================
// BILLING — Payments (receive from customers / pay to carriers)
// ============================================================================

model ModeOfPayment {
  id          String    @id @default(cuid())
  tenantId    String
  name        String
  accountCode String
  isDefault   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  payments    Payment[]
  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("modes_of_payment")
}

model Payment {
  id              String              @id @default(cuid())
  tenantId        String
  paymentNumber   String
  type            PaymentType
  status          PaymentStatus       @default(DRAFT)
  partyType       PaymentPartyType
  partyId         String
  modeOfPaymentId String
  date            DateTime
  currency        String              @default("CAD")
  totalAmount     Decimal             @db.Decimal(12, 2)
  reference       String?
  note            String?
  submittedAt     DateTime?
  cancelledAt     DateTime?
  reconciledAt    DateTime?
  createdById     String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  tenant          Tenant              @relation(fields: [tenantId], references: [id])
  modeOfPayment   ModeOfPayment       @relation(fields: [modeOfPaymentId], references: [id])
  allocations     PaymentAllocation[]
  @@unique([tenantId, paymentNumber])
  @@index([tenantId, status])
  @@index([tenantId, partyType, partyId])
  @@map("payments")
}

model PaymentAllocation {
  id         String            @id @default(cuid())
  tenantId   String
  paymentId  String
  targetType PaymentTargetType
  targetId   String
  amount     Decimal           @db.Decimal(12, 2)
  payment    Payment           @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  @@index([tenantId, targetType, targetId])
  @@index([tenantId, paymentId])
  @@map("payment_allocations")
}

// ============================================================================
// BILLING — Tax Templates (multi-rate tax models, SALES + PURCHASE)
// ============================================================================

model TaxTemplate {
  id        String          @id @default(cuid())
  tenantId  String
  name      String
  type      TaxTemplateType
  isDefault Boolean         @default(false)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  tenant Tenant            @relation(fields: [tenantId], references: [id])
  lines  TaxTemplateLine[]

  @@unique([tenantId, name])
  @@index([tenantId, type])
  @@map("tax_templates")
}

model TaxTemplateLine {
  id          String  @id @default(cuid())
  tenantId    String
  templateId  String
  description String
  rate        Decimal @db.Decimal(7, 4)
  accountCode String
  sortOrder   Int     @default(0)

  template TaxTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([tenantId, templateId])
  @@map("tax_template_lines")
}

// ============================================================================
// BILLING — Banking (bank accounts + transactions + reconciliation)
// ============================================================================

model BankAccount {
  id            String   @id @default(cuid())
  tenantId      String
  name          String
  accountNumber String?            // masqué à l'affichage (4 derniers)
  glAccountCode String   @default("1010")
  currency      String   @default("CAD")
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  transactions  BankTransaction[]
  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("bank_accounts")
}

model BankTransaction {
  id               String        @id @default(cuid())
  tenantId         String
  bankAccountId    String
  date             DateTime
  description      String
  amount           Decimal       @db.Decimal(12, 2)   // signé
  reference        String?
  status           BankTxnStatus @default(UNRECONCILED)
  matchedPaymentId String?       @unique
  createdAt        DateTime      @default(now())
  bankAccount      BankAccount   @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  @@index([tenantId, bankAccountId, status])
  @@map("bank_transactions")
}

// ============================================================================
// BILLING — Budgets (annual per-account budget + variance vs GL)
// ============================================================================

model Budget {
  id         String   @id @default(cuid())
  tenantId   String
  name       String
  fiscalYear Int
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  lines      BudgetLine[]
  @@unique([tenantId, name, fiscalYear])
  @@index([tenantId, fiscalYear])
  @@map("budgets")
}

model BudgetLine {
  id          String  @id @default(cuid())
  tenantId    String
  budgetId    String
  accountCode String
  amount      Decimal @db.Decimal(12, 2)
  budget      Budget  @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  @@index([tenantId, budgetId])
  @@map("budget_lines")
}

// ============================================================================
// BILLING — Fixed Assets / Depreciation (module: billing)
// ============================================================================

model FixedAsset {
  id              String   @id @default(cuid())
  tenantId        String
  assetCode       String
  name            String
  category        String?
  acquisitionDate DateTime
  cost            Decimal  @db.Decimal(12, 2)
  salvageValue    Decimal  @default(0) @db.Decimal(12, 2)
  usefulLifeMonths Int
  method          DepreciationMethod @default(STRAIGHT_LINE)
  status          FixedAssetStatus   @default(DRAFT)
  accumulatedDepreciation Decimal @default(0) @db.Decimal(12, 2)
  depreciationExpenseAccountCode      String @default("5100")
  accumulatedDepreciationAccountCode  String @default("1590")
  disposedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  depreciations   DepreciationEntry[]
  @@unique([tenantId, assetCode])
  @@index([tenantId, status])
  @@map("fixed_assets")
}

model DepreciationEntry {
  id        String   @id @default(cuid())
  tenantId  String
  assetId   String
  period    DateTime
  amount    Decimal  @db.Decimal(12, 2)
  postedAt  DateTime @default(now())
  asset     FixedAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  @@unique([tenantId, assetId, period])
  @@index([tenantId, assetId])
  @@map("depreciation_entries")
}

// ============================================================================
// BILLING — Subscriptions (recurring billing, module: billing)
// ============================================================================

model Subscription {
  id          String               @id @default(cuid())
  tenantId    String
  name        String
  customerId  String
  status      SubscriptionStatus   @default(ACTIVE)
  interval    SubscriptionInterval @default(MONTHLY)
  startDate   DateTime
  nextRunDate DateTime
  currency    String               @default("CAD")
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  tenant      Tenant               @relation(fields: [tenantId], references: [id])
  customer    Customer             @relation(fields: [customerId], references: [id])
  lines       SubscriptionLine[]
  generated   SubscriptionInvoice[]
  @@index([tenantId, status, nextRunDate])
  @@map("subscriptions")
}

model SubscriptionLine {
  id             String       @id @default(cuid())
  tenantId       String
  subscriptionId String
  description    String
  amount         Decimal      @db.Decimal(12, 2)
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  @@index([tenantId, subscriptionId])
  @@map("subscription_lines")
}

model SubscriptionInvoice {
  id                String       @id @default(cuid())
  tenantId          String
  subscriptionId    String
  periodStart       DateTime
  customerInvoiceId String
  createdAt         DateTime     @default(now())
  subscription      Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  @@unique([tenantId, subscriptionId, periodStart])
  @@index([tenantId, subscriptionId])
  @@map("subscription_invoices")
}
