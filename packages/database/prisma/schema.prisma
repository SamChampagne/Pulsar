// Pulsar — Prisma schema
//
// Multi-tenancy strategy: shared database, shared schema. Every tenant-scoped
// model carries a `tenantId` column and an index on it. Isolation is enforced
// at the application layer (every query in apps/api filters by the tenant
// resolved from the JWT). See docs/multi-tenancy.md.
//
// Status enums mirror packages/shared/src/enums — keep both in sync.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// CORE — tenants, identity, RBAC
// ============================================================================

enum TenantStatus {
  TRIAL
  ACTIVE
  SUSPENDED
}

model Tenant {
  id        String       @id @default(cuid())
  slug      String       @unique
  name      String
  status    TenantStatus @default(TRIAL)
  settings  Json         @default("{}")
  // OIDC SSO config: { enabled, issuer, clientId, clientSecret (enc:v1), defaultRoleId }
  authConfig Json?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  users             User[]
  roles             Role[]
  auditLogs         AuditLog[]
  documents         Document[]
  notifications     Notification[]
  integrations      Integration[]
  webhookDeliveries WebhookDelivery[]
  apiKeys           ApiKey[]
  modules           TenantModule[]
  customers         Customer[]
  locations         Location[]
  carriers          Carrier[]
  drivers           Driver[]
  vehicles          Vehicle[]
  trailers          Trailer[]
  transportOrders   TransportOrder[]
  shipments         Shipment[]
  loads             Load[]
  tenders           Tender[]
  lanePreferences     LaneCarrierPreference[]
  lanes               Lane[]
  accessorials        Accessorial[]
  fuelSurchargeTables FuelSurchargeTable[]
  invoices            Invoice[]
  routes            Route[]
  stops             Stop[]
  rates             Rate[]
  trackingEvents    TrackingEvent[]
  proofsOfDelivery  ProofOfDelivery[]
  shipmentLoadLegs  ShipmentLoadLeg[]
  customerInvoices  CustomerInvoice[]
  agents            Agent[]
  proposedActions   ProposedAction[]
  agentConversations AgentConversation[]
  agentRuntimeConfig AgentRuntimeConfig?
  agentRuns         AgentRun[]
  incomingCarrierInvoices IncomingCarrierInvoice[]
  maintenanceOrders       MaintenanceOrder[]
  maintenanceSchedules    MaintenanceSchedule[]
  complianceDocuments     ComplianceDocument[]
  wmsItems        WmsItem[]
  wmsBins         Bin[]
  inventoryLevels InventoryLevel[]
  stockMovements  StockMovement[]
  receipts        Receipt[]
  pickOrders      PickOrder[]
  cycleCounts      CycleCount[]
  cycleCountLines  CycleCountLine[]
  yardSpots        YardSpot[]
  yardVisits       YardVisit[]
  yardMoves        YardMove[]
  dockAppointments DockAppointment[]
  inboundMessages  InboundMessage[]
  importBatches    ImportBatch[]
  importRows       ImportRow[]

  @@map("tenants")
}

// Per-tenant atomic counters for business document numbers (TO/SH/LD...).
// Incremented via INSERT ... ON CONFLICT DO UPDATE RETURNING (see SequencesService).
model NumberSequence {
  tenantId String @map("tenant_id")
  key      String
  value    Int    @default(0)

  @@id([tenantId, key])
  @@map("number_sequences")
}

enum UserStatus {
  INVITED
  ACTIVE
  DISABLED
}

model User {
  id           String     @id @default(cuid())
  tenantId     String
  email        String
  passwordHash String
  firstName    String
  lastName     String
  status       UserStatus @default(ACTIVE)
  // Stable OIDC identifier (ID token "sub"); email is only a first-login fallback.
  oidcSubject  String?
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  tenant                 Tenant            @relation(fields: [tenantId], references: [id])
  roles                  UserRole[]
  refreshTokens          RefreshToken[]
  actionTokens           UserActionToken[]
  auditLogs              AuditLog[]
  notifications          Notification[]
  uploadedDocuments      Document[]
  createdTransportOrders TransportOrder[]
  recordedTrackingEvents TrackingEvent[]
  receivedPods           ProofOfDelivery[]
  agentServiceFor        Agent[]           @relation("AgentServiceUser")
  preferences            UserPreferences?

  @@unique([tenantId, email])
  @@unique([tenantId, oidcSubject])
  @@index([tenantId])
  @@map("users")
}

model UserPreferences {
  id         String   @id @default(cuid())
  userId     String   @unique
  deskLayout Json     @default("{}")
  appearance Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

// Inbound API keys (read-only scopes in v1). Only the SHA-256 hash is stored;
// the prefix is kept for display ("pk_ab12cd34…").
model ApiKey {
  id          String    @id @default(cuid())
  tenantId    String
  name        String
  prefix      String
  keyHash     String    @unique
  scopes      String[]
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdById String?
  createdAt   DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("api_keys")
}

enum UserActionTokenKind {
  INVITATION
  PASSWORD_RESET
  OIDC_EXCHANGE
}

// One-shot tokens for invitation acceptance and password resets (hash at rest).
model UserActionToken {
  id        String              @id @default(cuid())
  userId    String
  kind      UserActionTokenKind
  tokenHash String              @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_action_tokens")
}

// Rotating refresh tokens (only the SHA-256 hash is stored).
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

enum PlatformUserStatus {
  ACTIVE
  DISABLED
}

// Cross-tenant operators (create/suspend tenants). Deliberately has NO relation
// to any tenant-scoped model — the platform plane never mixes with tenant data.
model PlatformUser {
  id           String             @id @default(cuid())
  email        String             @unique
  passwordHash String
  firstName    String
  lastName     String
  status       PlatformUserStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  // MFA (TOTP). totpSecret encrypted at rest (enc:v1, CryptoService); recovery
  // codes are bcrypt-hashed and single-use (consumed codes are removed).
  totpSecret    String?
  mfaEnabledAt  DateTime?
  recoveryCodes String[]  @default([])
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@map("platform_users")
}

model Role {
  id          String   @id @default(cuid())
  tenantId    String
  key         String
  name        String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  permissions RolePermission[]
  users       UserRole[]

  @@unique([tenantId, key])
  @@index([tenantId])
  @@map("roles")
}

// Platform-wide permission catalog, seeded from packages/shared.
model Permission {
  id          String @id @default(cuid())
  key         String @unique
  module      String
  description String

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

// ============================================================================
// CORE — audit, documents, notifications, integrations, module registry
// ============================================================================

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String
  userId     String?
  action     String // CREATE | UPDATE | DELETE | STATUS_CHANGE | LOGIN
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User?  @relation(fields: [userId], references: [id])

  @@index([tenantId, entityType, entityId])
  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

// Document metadata only — binary storage (S3/local) is referenced by storageKey.
model Document {
  id           String   @id @default(cuid())
  tenantId     String
  entityType   String
  entityId     String
  fileName     String
  mimeType     String
  sizeBytes    Int
  storageKey   String
  uploadedById String?
  createdAt    DateTime @default(now())

  tenant     Tenant @relation(fields: [tenantId], references: [id])
  uploadedBy User?  @relation(fields: [uploadedById], references: [id])

  @@index([tenantId, entityType, entityId])
  @@map("documents")
}

enum NotificationLevel {
  INFO
  WARNING
  CRITICAL
}

model Notification {
  id        String            @id @default(cuid())
  tenantId  String
  // null = tenant-wide notification (e.g. delay alerts); read-by-one = read-for-all (v1)
  userId    String?
  level     NotificationLevel @default(INFO)
  title     String
  body      String
  payload   Json?
  readAt    DateTime?
  createdAt DateTime          @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User?  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, readAt])
  @@map("notifications")
}

enum IntegrationStatus {
  DISABLED
  ENABLED
  ERROR
}

model Integration {
  id        String            @id @default(cuid())
  tenantId  String
  key       String // e.g. "telematics-samsara", "edi-204"
  name      String
  status    IntegrationStatus @default(DISABLED)
  config    Json              @default("{}")
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  tenant     Tenant            @relation(fields: [tenantId], references: [id])
  deliveries WebhookDelivery[]

  @@unique([tenantId, key])
  @@index([tenantId])
  @@map("integrations")
}

enum WebhookDeliveryStatus {
  PENDING
  DELIVERED
  FAILED
}

// Durable outbox for outbound webhooks: retried with backoff until delivered
// or the attempt budget is exhausted.
model WebhookDelivery {
  id            String                @id @default(cuid())
  tenantId      String
  integrationId String
  event         String
  payload       Json
  status        WebhookDeliveryStatus @default(PENDING)
  attempts      Int                   @default(0)
  nextAttemptAt DateTime              @default(now())
  lastError     String?
  deliveredAt   DateTime?
  createdAt     DateTime              @default(now())

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([tenantId, integrationId, createdAt])
  @@map("webhook_deliveries")
}

// Platform module catalog (core, transportation, fleet, ...).
model ModuleDefinition {
  id          String  @id @default(cuid())
  key         String  @unique
  name        String
  description String
  isCore      Boolean @default(false)
  available   Boolean @default(false)

  tenants TenantModule[]

  @@map("module_definitions")
}

// Per-tenant module activation — the heart of the modular platform.
model TenantModule {
  tenantId  String
  moduleId  String
  enabled   Boolean  @default(false)
  settings  Json     @default("{}")
  enabledAt DateTime?

  tenant Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  module ModuleDefinition @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@id([tenantId, moduleId])
  @@map("tenant_modules")
}

// ============================================================================
// TRANSPORTATION — master data
// ============================================================================

model Customer {
  id          String   @id @default(cuid())
  tenantId    String
  code        String
  name        String
  contactName String?
  email       String?
  phone       String?
  notes       String?
  // Customer Portal capability link (module customer-portal must be enabled).
  portalToken String?  @unique
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant           Tenant            @relation(fields: [tenantId], references: [id])
  locations        Location[]
  transportOrders  TransportOrder[]
  rates            Rate[]
  customerInvoices CustomerInvoice[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("customers")
}

enum LocationType {
  PLANT
  WAREHOUSE
  DISTRIBUTION_CENTER
  CUSTOMER_SITE
  CARRIER_TERMINAL
  OTHER
}

model Location {
  id           String       @id @default(cuid())
  tenantId     String
  customerId   String?
  code         String
  name         String
  type         LocationType @default(OTHER)
  addressLine1 String
  addressLine2 String?
  city         String
  state        String?
  postalCode   String?
  country      String       @default("CA")
  latitude     Float?
  longitude    Float?
  timezone     String?
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  tenant               Tenant           @relation(fields: [tenantId], references: [id])
  customer             Customer?        @relation(fields: [customerId], references: [id])
  originOrders         TransportOrder[] @relation("OrderOrigin")
  destinationOrders    TransportOrder[] @relation("OrderDestination")
  originShipments      Shipment[]       @relation("ShipmentOrigin")
  destinationShipments Shipment[]       @relation("ShipmentDestination")
  stops                Stop[]
  laneOrigins          Lane[] @relation("LaneOrigin")
  laneDestinations     Lane[] @relation("LaneDestination")
  bins       Bin[]
  receipts   Receipt[]
  pickOrders PickOrder[]
  yardSpots        YardSpot[]
  yardVisits       YardVisit[]
  dockAppointments DockAppointment[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("locations")
}

enum CarrierStatus {
  ACTIVE
  INACTIVE
}

model Carrier {
  id          String        @id @default(cuid())
  tenantId    String
  code        String
  name        String
  scacCode    String?
  mcNumber    String?
  dotNumber   String?
  contactName String?
  email       String?
  phone       String?
  status      CarrierStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  drivers  Driver[]
  vehicles Vehicle[]
  trailers Trailer[]
  loads    Load[]
  rates    Rate[]
  tenders  Tender[]
  lanePreferences LaneCarrierPreference[]
  invoices Invoice[]
  incomingCarrierInvoices IncomingCarrierInvoice[]
  yardVisits       YardVisit[]
  dockAppointments DockAppointment[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("carriers")
}

enum DriverStatus {
  ACTIVE
  INACTIVE
}

model Driver {
  id            String       @id @default(cuid())
  tenantId      String
  carrierId     String? // null = internal fleet driver
  firstName     String
  lastName      String
  licenseNumber String?
  phone         String?
  email         String?
  status        DriverStatus @default(ACTIVE)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  tenant  Tenant   @relation(fields: [tenantId], references: [id])
  carrier Carrier? @relation(fields: [carrierId], references: [id])
  loads   Load[]

  @@index([tenantId])
  @@map("drivers")
}

enum AssetStatus {
  AVAILABLE
  IN_SERVICE
  MAINTENANCE
  RETIRED
}

enum VehicleType {
  TRACTOR
  STRAIGHT_TRUCK
  VAN
  OTHER
}

model Vehicle {
  id         String      @id @default(cuid())
  tenantId   String
  carrierId  String?
  unitNumber String
  type       VehicleType @default(TRACTOR)
  make       String?
  model      String?
  year       Int?
  vin        String?
  plate      String?
  status     AssetStatus @default(AVAILABLE)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  tenant               Tenant                @relation(fields: [tenantId], references: [id])
  carrier              Carrier?              @relation(fields: [carrierId], references: [id])
  loads                Load[]
  maintenanceOrders    MaintenanceOrder[]
  maintenanceSchedules MaintenanceSchedule[]

  @@unique([tenantId, unitNumber])
  @@index([tenantId])
  @@map("vehicles")
}

enum TrailerType {
  DRY_VAN
  REEFER
  FLATBED
  TANKER
  OTHER
}

model Trailer {
  id               String      @id @default(cuid())
  tenantId         String
  carrierId        String?
  unitNumber       String
  type             TrailerType @default(DRY_VAN)
  capacityWeightKg Float?
  capacityVolumeM3 Float?
  capacityPallets  Int?
  plate            String?
  status           AssetStatus @default(AVAILABLE)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  tenant               Tenant                @relation(fields: [tenantId], references: [id])
  carrier              Carrier?              @relation(fields: [carrierId], references: [id])
  loads                Load[]
  maintenanceOrders    MaintenanceOrder[]
  maintenanceSchedules MaintenanceSchedule[]
  yardVisits           YardVisit[]

  @@unique([tenantId, unitNumber])
  @@index([tenantId])
  @@map("trailers")
}

// ============================================================================
// FLEET — maintenance & compliance (mirror of @pulsar/shared fleet enums)
// ============================================================================

enum MaintenanceType {
  PREVENTIVE
  REPAIR
  INSPECTION
}

enum MaintenanceOrderStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ComplianceSubject {
  VEHICLE
  TRAILER
  DRIVER
}

enum ComplianceDocType {
  REGISTRATION
  INSURANCE
  INSPECTION
  LICENSE
  MEDICAL
  OTHER
}

// ============================================================================
// TRANSPORTATION — orders, planning, execution
// Workflow: TransportOrder → Shipment → Load → Route → Dispatch → In Transit
//           → Delivered → Closed (see packages/shared/src/workflows)
// ============================================================================

enum TransportOrderStatus {
  DRAFT
  CONFIRMED
  PLANNED
  IN_EXECUTION
  COMPLETED
  CLOSED
  CANCELLED
}

// Customer demand — the commercial request to move freight (OTM "order release").
model TransportOrder {
  id                    String               @id @default(cuid())
  tenantId              String
  orderNumber           String
  customerId            String
  customerReference     String?
  status                TransportOrderStatus @default(DRAFT)
  mode                  TransportMode        @default(FTL)
  originLocationId      String
  destinationLocationId String
  requestedPickupEarly   DateTime?
  requestedPickupLate    DateTime?
  requestedDeliveryEarly DateTime?
  requestedDeliveryLate  DateTime?
  totalWeightKg         Float?
  totalVolumeM3         Float?
  palletCount           Int?
  notes                 String?
  createdById           String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  tenant              Tenant                @relation(fields: [tenantId], references: [id])
  customer            Customer              @relation(fields: [customerId], references: [id])
  originLocation      Location              @relation("OrderOrigin", fields: [originLocationId], references: [id])
  destinationLocation Location              @relation("OrderDestination", fields: [destinationLocationId], references: [id])
  createdBy           User?                 @relation(fields: [createdById], references: [id])
  shipments           Shipment[]
  customerInvoiceLine CustomerInvoiceLine?

  @@unique([tenantId, orderNumber])
  @@index([tenantId, status])
  @@index([tenantId, customerId])
  @@map("transport_orders")
}

enum ShipmentStatus {
  PENDING
  PLANNED
  DISPATCHED
  IN_TRANSIT
  DELIVERED
  CLOSED
  CANCELLED
}

// Planning/execution unit derived from an order (SAP TM "freight unit").
model Shipment {
  id                    String         @id @default(cuid())
  tenantId              String
  shipmentNumber        String
  transportOrderId      String
  status                ShipmentStatus @default(PENDING)
  // Public share token: anyone with it can view the read-only tracking page.
  trackingToken         String?        @unique
  originLocationId      String
  destinationLocationId String
  loadId                String?
  weightKg              Float?
  volumeM3              Float?
  palletCount           Int?
  plannedPickupEarly    DateTime?
  plannedPickupLate     DateTime?
  plannedDeliveryEarly  DateTime?
  plannedDeliveryLate   DateTime?
  actualPickupAt        DateTime?
  actualDeliveryAt      DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  tenant              Tenant           @relation(fields: [tenantId], references: [id])
  transportOrder      TransportOrder   @relation(fields: [transportOrderId], references: [id])
  originLocation      Location         @relation("ShipmentOrigin", fields: [originLocationId], references: [id])
  destinationLocation Location         @relation("ShipmentDestination", fields: [destinationLocationId], references: [id])
  load                Load?            @relation(fields: [loadId], references: [id])
  stops               Stop[]
  trackingEvents      TrackingEvent[]
  proofOfDelivery     ProofOfDelivery?
  legs                ShipmentLoadLeg[]
  pickOrders          PickOrder[]

  @@unique([tenantId, shipmentNumber])
  @@index([tenantId, status])
  @@index([tenantId, transportOrderId])
  @@map("shipments")
}

enum LoadStatus {
  OPEN
  PLANNED
  TENDERED
  DISPATCHED
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

// Physical consolidation assigned to a carrier/vehicle (SAP TM "freight order").
model Load {
  id            String        @id @default(cuid())
  tenantId      String
  loadNumber    String
  status        LoadStatus    @default(OPEN)
  mode          TransportMode @default(FTL)
  carrierId     String?
  driverId      String?
  vehicleId     String?
  trailerId     String?
  rateId        String?
  // Estimated buy-side cost computed from the assigned rate (see calculateRateCost).
  estimatedCost Decimal?   @db.Decimal(12, 2)
  costCurrency  String?
  // Frozen calculation snapshot (rate as used + inputs + lines). See spec invariants:
  // a COMPLETED load is never recomputed; reconciliation reads this, never recomputes.
  costDetail    Json?
  // Public driver token: grants stop check-in/out + POD capture on this load only.
  driverToken   String?    @unique
  dispatchedAt  DateTime?
  completedAt   DateTime?
  notes         String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  carrier        Carrier?        @relation(fields: [carrierId], references: [id])
  driver         Driver?         @relation(fields: [driverId], references: [id])
  vehicle        Vehicle?        @relation(fields: [vehicleId], references: [id])
  trailer        Trailer?        @relation(fields: [trailerId], references: [id])
  rate           Rate?           @relation(fields: [rateId], references: [id])
  shipments      Shipment[]
  route          Route?
  trackingEvents TrackingEvent[]
  tenders        Tender[]
  accessorials   LoadAccessorial[]
  invoiceLine    InvoiceLine?
  legs           ShipmentLoadLeg[]

  @@unique([tenantId, loadNumber])
  @@index([tenantId, status])
  @@map("loads")
}

// Junction shipment×load×sequence — unlocks future multi-leg (audit §3). In v1
// (single-leg) it mirrors Shipment.loadId, written in the SAME transaction: never
// divergent. loadId stays as the "current leg" denormalization for existing readers.
model ShipmentLoadLeg {
  id         String   @id @default(cuid())
  tenantId   String
  shipmentId String
  loadId     String
  sequence   Int      @default(1)
  createdAt  DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  load     Load     @relation(fields: [loadId], references: [id], onDelete: Restrict)

  @@unique([shipmentId, sequence])
  @@unique([shipmentId, loadId])
  @@index([tenantId])
  @@index([loadId])
  @@map("shipment_load_legs")
}

enum TenderStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELLED
}

// Offer sent to a carrier to haul a load. The carrier responds through a
// public tokenized link — no Pulsar account required.
model Tender {
  id            String       @id @default(cuid())
  tenantId      String
  loadId        String
  carrierId     String
  status        TenderStatus @default(PENDING)
  // Part of an automatic sequence: on decline/expiry the next carrier in the
  // lane preference list is tendered automatically.
  isAuto        Boolean      @default(false)
  token         String       @unique
  message       String?
  declineReason String?
  expiresAt     DateTime
  sentAt        DateTime     @default(now())
  respondedAt   DateTime?

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  load    Load    @relation(fields: [loadId], references: [id], onDelete: Cascade)
  carrier Carrier @relation(fields: [carrierId], references: [id])

  @@index([tenantId, loadId])
  @@index([status, expiresAt])
  @@map("tenders")
}

// Geographic level of a lane endpoint, most → least specific (mirror of @pulsar/shared).
enum LaneEndpointType {
  LOCATION
  CITY
  STATE
  COUNTRY
}

// First-class lane: each endpoint is one level of the geo hierarchy site < city < state < country.
// originKey/destinationKey are normalized matching keys (see packages/shared rating/lane-key.ts);
// the unique below makes strictly identical lanes impossible.
model Lane {
  id                    String           @id @default(cuid())
  tenantId              String
  name                  String?
  originType            LaneEndpointType
  originLocationId      String?
  originCity            String?
  originState           String?
  originCountry         String?
  destinationType       LaneEndpointType
  destinationLocationId String?
  destinationCity       String?
  destinationState      String?
  destinationCountry    String?
  originKey             String
  destinationKey        String
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  tenant              Tenant                  @relation(fields: [tenantId], references: [id])
  // Restrict intentionally: a LOCATION-level lane's originKey embeds the location id —
  // SET NULL would orphan the key. Same policy as every rating-entity reference.
  originLocation      Location?               @relation("LaneOrigin", fields: [originLocationId], references: [id], onDelete: Restrict)
  destinationLocation Location?               @relation("LaneDestination", fields: [destinationLocationId], references: [id], onDelete: Restrict)
  rates               Rate[]
  carrierPreferences  LaneCarrierPreference[]

  @@unique([tenantId, originKey, destinationKey])
  @@index([tenantId])
  @@map("lanes")
}

// Ordered carrier preference per lane (origin → destination pair).
// Drives auto-tendering: rank 1 is offered first, then rank 2 on decline/expiry, etc.
model LaneCarrierPreference {
  id        String @id @default(cuid())
  tenantId  String
  laneId    String
  carrierId String
  rank      Int

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  lane    Lane    @relation(fields: [laneId], references: [id], onDelete: Restrict)
  carrier Carrier @relation(fields: [carrierId], references: [id])

  @@unique([tenantId, laneId, rank], map: "lane_prefs_lane_rank_key")
  @@unique([tenantId, laneId, carrierId], map: "lane_prefs_lane_carrier_key")
  @@map("lane_carrier_preferences")
}

enum DistanceSource {
  MANUAL
  OSRM
  HAVERSINE
}

// Ordered stop sequence for a load.
model Route {
  id                   String   @id @default(cuid())
  tenantId             String
  loadId               String   @unique
  totalDistanceKm      Float?
  estimatedDurationMin Int?
  // Provenance of totalDistanceKm — MANUAL is never overwritten by recomputes.
  distanceSource       DistanceSource?
  // OSRM route geometry (GeoJSON LineString, [lng, lat] order). Display only.
  geometry             Json?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  load   Load   @relation(fields: [loadId], references: [id], onDelete: Cascade)
  stops  Stop[]

  @@index([tenantId])
  @@map("routes")
}

enum StopType {
  PICKUP
  DELIVERY
}

enum StopStatus {
  PENDING
  ARRIVED
  DEPARTED
  COMPLETED
  SKIPPED
}

model Stop {
  id                 String     @id @default(cuid())
  tenantId           String
  routeId            String
  sequence           Int
  type               StopType
  status             StopStatus @default(PENDING)
  locationId         String
  shipmentId         String?
  plannedArrivalEarly DateTime?
  plannedArrivalLate  DateTime?
  plannedDepartureAt DateTime?
  actualArrivalAt    DateTime?
  actualDepartureAt  DateTime?
  notes              String?

  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  route          Route           @relation(fields: [routeId], references: [id], onDelete: Cascade)
  location       Location        @relation(fields: [locationId], references: [id])
  shipment       Shipment?       @relation(fields: [shipmentId], references: [id])
  trackingEvents TrackingEvent[]

  @@unique([routeId, sequence])
  @@index([tenantId])
  @@map("stops")
}

enum RateType {
  FLAT
  PER_KM
  PER_HUNDREDWEIGHT
  PER_PALLET
  SPOT
}

enum RateStatus {
  DRAFT
  ACTIVE
  EXPIRED
}

// Simple rate offering (buy-side carrier rate or sell-side customer rate).
model Rate {
  id               String         @id @default(cuid())
  tenantId         String
  name             String
  carrierId        String?
  customerId       String?
  laneId           String?
  fuelTableId      String?
  rateType         RateType       @default(FLAT)
  // null = applies to all modes
  mode             TransportMode?
  currency         String         @default("CAD")
  baseAmount       Decimal        @db.Decimal(12, 2)
  fuelSurchargePct Float?
  minCharge        Decimal?       @db.Decimal(12, 2)
  validFrom        DateTime?
  validTo          DateTime?
  status           RateStatus     @default(DRAFT)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  tenant            Tenant                 @relation(fields: [tenantId], references: [id])
  carrier           Carrier?               @relation(fields: [carrierId], references: [id])
  customer          Customer?              @relation(fields: [customerId], references: [id])
  // Restrict intentionally: deleting a lane/fuel table with live rates must fail loudly,
  // never silently detach pricing (see plan phase 7.1, deletion policy).
  lane              Lane?                  @relation(fields: [laneId], references: [id], onDelete: Restrict)
  fuelTable         FuelSurchargeTable?    @relation(fields: [fuelTableId], references: [id], onDelete: Restrict)
  breaks            RateBreak[]
  accessorialPrices RateAccessorialPrice[]
  loads             Load[]

  @@index([tenantId])
  @@index([tenantId, laneId])
  @@map("rates")
}

// Degressive weight bracket of a PER_HUNDREDWEIGHT rate (amount per CWT up to upToKg).
model RateBreak {
  id     String  @id @default(cuid())
  rateId String
  upToKg Float
  amount Decimal @db.Decimal(12, 2)

  rate Rate @relation(fields: [rateId], references: [id], onDelete: Cascade)

  @@unique([rateId, upToKg])
  @@map("rate_breaks")
}

// Pricing unit of an accessorial charge (mirror of @pulsar/shared).
enum AccessorialUnit {
  FLAT
  PER_HOUR
  PER_UNIT
}

// Shipping mode (mirror of @pulsar/shared). Default FTL.
enum TransportMode {
  FTL
  LTL
  PARCEL
}

// Tenant accessorial catalog (tailgate, wait time, residential…).
model Accessorial {
  id        String          @id @default(cuid())
  tenantId  String
  code      String
  name      String
  unit      AccessorialUnit @default(FLAT)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  tenant           Tenant                 @relation(fields: [tenantId], references: [id])
  ratePrices       RateAccessorialPrice[]
  loadAccessorials LoadAccessorial[]

  @@unique([tenantId, code])
  @@map("accessorials")
}

// Price of one accessorial under one rate — lets rate shopping compare carriers like for like.
model RateAccessorialPrice {
  id            String  @id @default(cuid())
  rateId        String
  accessorialId String
  amount        Decimal @db.Decimal(12, 2)

  rate        Rate        @relation(fields: [rateId], references: [id], onDelete: Cascade)
  accessorial Accessorial @relation(fields: [accessorialId], references: [id], onDelete: Restrict)

  @@unique([rateId, accessorialId])
  @@map("rate_accessorial_prices")
}

// Accessorials the planner flagged on a load (quantity forced to 1 for FLAT units).
model LoadAccessorial {
  id            String @id @default(cuid())
  loadId        String
  accessorialId String
  quantity      Float  @default(1)

  load        Load        @relation(fields: [loadId], references: [id], onDelete: Cascade)
  accessorial Accessorial @relation(fields: [accessorialId], references: [id], onDelete: Restrict)

  @@unique([loadId, accessorialId])
  @@map("load_accessorials")
}

// Dated fuel surcharge table; the entry in force at the load's reference date applies.
model FuelSurchargeTable {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant               @relation(fields: [tenantId], references: [id])
  entries FuelSurchargeEntry[]
  rates   Rate[]

  @@index([tenantId])
  @@map("fuel_surcharge_tables")
}

model FuelSurchargeEntry {
  id            String   @id @default(cuid())
  tableId       String
  effectiveFrom DateTime
  pct           Float

  table FuelSurchargeTable @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@unique([tableId, effectiveFrom])
  @@map("fuel_surcharge_entries")
}

enum TrackingEventType {
  CREATED
  PLANNED
  DISPATCHED
  POSITION_UPDATE
  ARRIVED_AT_STOP
  DEPARTED_STOP
  DELAYED
  EXCEPTION
  DELIVERED
  CANCELLED
}

model TrackingEvent {
  id           String            @id @default(cuid())
  tenantId     String
  type         TrackingEventType
  loadId       String?
  shipmentId   String?
  stopId       String?
  message      String?
  latitude     Float?
  longitude    Float?
  payload      Json?
  occurredAt   DateTime          @default(now())
  recordedById String?
  createdAt    DateTime          @default(now())
  /// Race-proof dedup for synthetic events (e.g. 'DELAYED:<stopId>:<deadlineISO>'); null for ordinary events (Postgres allows multiple nulls).
  dedupKey     String?           @unique

  tenant     Tenant    @relation(fields: [tenantId], references: [id])
  load       Load?     @relation(fields: [loadId], references: [id])
  shipment   Shipment? @relation(fields: [shipmentId], references: [id])
  stop       Stop?     @relation(fields: [stopId], references: [id])
  recordedBy User?     @relation(fields: [recordedById], references: [id])

  @@index([tenantId, loadId, occurredAt])
  @@index([tenantId, shipmentId, occurredAt])
  @@map("tracking_events")
}

// Global geocode cache — NOT tenant-scoped: address → coords is not tenant data.
model GeocodeCache {
  id         String   @id @default(cuid())
  addressKey String   @unique
  latitude   Float
  longitude  Float
  provider   String
  createdAt  DateTime @default(now())

  @@map("geocode_cache")
}

// ============================================================================
// BILLING — carrier settlement (buy-side) v1
// ============================================================================

enum InvoiceStatus {
  DRAFT
  APPROVED
  DISPUTED
  PAID
}

enum DisputeReasonCode {
  RATE_MISMATCH
  QUANTITY_MISMATCH
  UNEXPECTED_CHARGE
  DUPLICATE_BILLING
  OTHER
}

enum FreightAuditStatus {
  RECEIVED
  MATCHED
  FLAGGED
  DISPUTED
  RESOLVED
  PAID
}

// Draft invoice grouping the estimated costs of a carrier's completed,
// not-yet-invoiced loads. Reconciled against the carrier's actual invoice
// (tolerance on gross variance), disputed when over, PAID tracked.
model Invoice {
  id            String        @id @default(cuid())
  tenantId      String
  invoiceNumber String
  carrierId     String
  status        InvoiceStatus @default(DRAFT)
  currency      String        @default("CAD")
  totalAmount   Decimal       @db.Decimal(12, 2)
  approvedAt    DateTime?

  // --- Reconciliation against the carrier's actual invoice -------------------
  carrierInvoiceNumber String?
  invoicedTotal        Decimal?           @db.Decimal(12, 2)
  // Net (signed) variance — display; the tolerance rides on varianceGross.
  varianceTotal        Decimal?           @db.Decimal(12, 2)
  varianceGross        Decimal?           @db.Decimal(12, 2)
  // Null until a human qualifies the dispute at resolution time (deliberate).
  disputeReasonCode    DisputeReasonCode?
  disputeNote          String?
  reconciledAt         DateTime?
  paidAt               DateTime?

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  tenant  Tenant        @relation(fields: [tenantId], references: [id])
  carrier Carrier       @relation(fields: [carrierId], references: [id])
  lines   InvoiceLine[]

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId, status])
  @@map("invoices")
}

model InvoiceLine {
  id          String  @id @default(cuid())
  invoiceId   String
  // One line per load; the unique constraint prevents double-billing a load.
  loadId      String  @unique
  description String
  amount      Decimal @db.Decimal(12, 2)
  invoicedAmount Decimal? @db.Decimal(12, 2)
  variance       Decimal? @db.Decimal(12, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  load    Load    @relation(fields: [loadId], references: [id])

  @@map("invoice_lines")
}

enum CustomerInvoiceStatus {
  DRAFT
  APPROVED
  SENT
  PAID
}

// Customer billing statement (sell-side): delivered orders priced with the
// CUSTOMER's rates (rating engine 7.1), one statement per currency encountered.
// Wording: emails/UI say "billing statement" until taxes exist (spec 7.3).
model CustomerInvoice {
  id            String                @id @default(cuid())
  tenantId      String
  invoiceNumber String
  customerId    String
  status        CustomerInvoiceStatus @default(DRAFT)
  currency      String                @default("CAD")
  totalAmount   Decimal               @db.Decimal(12, 2)
  approvedAt    DateTime?
  sentAt        DateTime?
  paidAt        DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  tenant   Tenant                @relation(fields: [tenantId], references: [id])
  customer Customer              @relation(fields: [customerId], references: [id])
  lines    CustomerInvoiceLine[]

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId, status])
  @@index([tenantId, customerId])
  @@map("customer_invoices")
}

model CustomerInvoiceLine {
  id                String  @id @default(cuid())
  customerInvoiceId String
  // One line per order; the unique prevents double-billing an order. Freed by
  // deleting a DRAFT statement (cascade) — the only escape path by design.
  transportOrderId  String  @unique
  description       String
  amount            Decimal @db.Decimal(12, 2)
  // Frozen sell-side snapshot (customer rate as used + inputs + lines), same
  // self-contained structure as Load.costDetail. Never recomputed once APPROVED.
  priceDetail       Json

  customerInvoice CustomerInvoice @relation(fields: [customerInvoiceId], references: [id], onDelete: Cascade)
  transportOrder  TransportOrder  @relation(fields: [transportOrderId], references: [id], onDelete: Restrict)

  @@map("customer_invoice_lines")
}

model IncomingCarrierInvoice {
  id                   String             @id @default(cuid())
  tenantId             String
  carrierId            String
  carrierInvoiceNumber String
  currency             String             @default("CAD")
  chargedTotal         Decimal            @db.Decimal(12, 2)
  receivedAt           DateTime           @default(now())
  status               FreightAuditStatus @default(RECEIVED)
  matchedTotal         Decimal?           @db.Decimal(12, 2)
  varianceTotal        Decimal?           @db.Decimal(12, 2)
  varianceGross        Decimal?           @db.Decimal(12, 2)
  recoveredAmount      Decimal            @default(0) @db.Decimal(12, 2)
  resolution           String?
  disputeReasonCode    String?
  disputeNote          String?
  auditedAt            DateTime?
  resolvedAt           DateTime?
  paidAt               DateTime?
  sourceRef            String             @default("manual")
  disputedByAgentId    String?
  createdById          String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  tenant  Tenant                @relation(fields: [tenantId], references: [id])
  carrier Carrier               @relation(fields: [carrierId], references: [id])
  lines   IncomingInvoiceLine[]

  @@index([tenantId, status])
  @@map("incoming_carrier_invoices")
}

model IncomingInvoiceLine {
  id             String   @id @default(cuid())
  invoiceId      String
  lineRef        String
  description    String?
  chargedAmount  Decimal  @db.Decimal(12, 2)
  matchedLoadId  String?
  expectedAmount Decimal? @db.Decimal(12, 2)
  variance       Decimal? @db.Decimal(12, 2)

  invoice IncomingCarrierInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("incoming_invoice_lines")
}

model ProofOfDelivery {
  id                  String   @id @default(cuid())
  tenantId            String
  shipmentId          String   @unique
  signedByName        String?
  signedAt            DateTime
  notes               String?
  // Signature image / photos are stored as Documents (entityType = "proof-of-delivery").
  signatureDocumentId String?
  receivedById        String?
  createdAt           DateTime @default(now())

  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  shipment   Shipment @relation(fields: [shipmentId], references: [id])
  receivedBy User?    @relation(fields: [receivedById], references: [id])

  @@index([tenantId])
  @@map("proof_of_deliveries")
}

// ---------------------------------------------------------------------------
// Phase 11 — Agent governance (mirrored enums in packages/shared/src/agents/risk.ts)
// ---------------------------------------------------------------------------

enum AgentStatus {
  ACTIVE
  PAUSED
  REVOKED
}

enum AgentAutonomy {
  PROPOSE
  ACT_LOW
  AUTONOMOUS
}

enum RiskTier {
  READ
  LOW
  MUTATING
  SENSITIVE
}

enum ProposalStatus {
  PENDING
  APPROVED
  REJECTED
  EXECUTED
  FAILED
}

enum AgentRunTrigger {
  EVENT
  CRON
  MANUAL
}

enum AgentRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
  KILLED
}

model Agent {
  id            String      @id @default(cuid())
  tenantId      String
  name          String
  description   String?
  permissions   String[]
  caps          Json        @default("{}")
  prefix        String
  secretHash    String      @unique
  serviceUserId String
  status        AgentStatus @default(ACTIVE)
  persona       String?
  role          String?
  model         String?
  autonomyLevel AgentAutonomy @default(PROPOSE)
  avatar        String?
  lastUsedAt    DateTime?
  lastSeenAt    DateTime?
  lastRunAt        DateTime?
  breakerTrippedAt DateTime?
  createdById   String?
  createdAt     DateTime    @default(now())
  revokedAt     DateTime?

  tenant        Tenant              @relation(fields: [tenantId], references: [id])
  serviceUser   User                @relation("AgentServiceUser", fields: [serviceUserId], references: [id])
  proposals     ProposedAction[]
  conversations AgentConversation[]
  runs          AgentRun[]

  @@index([tenantId])
  @@map("agents")
}

model AgentConversation {
  id              String   @id @default(cuid())
  tenantId        String
  agentId         String
  userId          String
  hermesSessionId String?
  title           String?
  createdAt       DateTime @default(now())

  tenant   Tenant         @relation(fields: [tenantId], references: [id])
  agent    Agent          @relation(fields: [agentId], references: [id])
  messages AgentMessage[]

  @@index([tenantId, agentId])
  @@map("agent_conversations")
}

model AgentMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String
  content        String
  proposalId     String?
  createdAt      DateTime @default(now())

  conversation AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("agent_messages")
}

model ProposedAction {
  id             String         @id @default(cuid())
  tenantId       String
  agentId        String
  triggeredByRef String?
  tool           String
  argsJson       Json
  riskTier       RiskTier
  status         ProposalStatus @default(PENDING)
  autoApproved   Boolean        @default(false)
  idempotencyKey String
  decidedById    String?
  decidedAt      DateTime?
  resultJson     Json?
  proposedAt     DateTime       @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  agent  Agent  @relation(fields: [agentId], references: [id])

  @@unique([agentId, idempotencyKey])
  @@index([tenantId, status])
  @@map("proposed_actions")
}

model AgentRuntimeConfig {
  id           String    @id @default(cuid())
  tenantId     String    @unique
  provider     String
  authMode     String
  apiKeyEnc    String?
  defaultModel String?
  baseUrl      String?
  connectedAt  DateTime?
  lastTestAt   DateTime?
  lastTestOk   Boolean?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("agent_runtime_configs")
}

model AgentRun {
  id                  String          @id @default(cuid())
  tenantId            String
  agentId             String
  trigger             AgentRunTrigger
  taskId              String?
  triggeredByRef      String?
  status              AgentRunStatus  @default(QUEUED)
  attempt             Int             @default(1)
  startedAt           DateTime?
  finishedAt          DateTime?
  error               String?
  proposedActionCount Int             @default(0)
  model               String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  agent  Agent  @relation(fields: [agentId], references: [id])

  @@index([tenantId, agentId, createdAt])
  @@index([tenantId, status])
  @@map("agent_runs")
}

// ---------------------------------------------------------------------------
// Phase 12 — Operating Workbench (mirrored enums in packages/shared/src/enums/operating.ts)
// ---------------------------------------------------------------------------

enum OperationalTaskType {
  EXCEPTION
}

enum OperationalTaskStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  DISMISSED
}

enum TaskAssigneeType {
  UNASSIGNED
  HUMAN
  AGENT
}

enum DomainEventStatus {
  PENDING
  PROCESSED
  FAILED
}

// Durable domain-event outbox: mirrors WebhookDelivery pattern for internal
// event processing. Consumed by the workbench runner to generate operational tasks.
model DomainEvent {
  id          String            @id @default(cuid())
  tenantId    String
  type        String
  subjectType String?
  subjectId   String?
  payload     Json
  status      DomainEventStatus @default(PENDING)
  attempts    Int               @default(0)
  lastError   String?
  processedAt DateTime?
  createdAt   DateTime          @default(now())

  @@index([status, createdAt])
  @@index([tenantId, type, createdAt])
  @@map("domain_events")
}

// Operational task surface — exceptions and alerts surfaced to human dispatchers
// or agents. The (tenantId, dedupKey) unique constraint enforces idempotent creation.
model OperationalTask {
  id              String                @id @default(cuid())
  tenantId        String
  type            OperationalTaskType
  category        String
  status          OperationalTaskStatus @default(OPEN)
  severity        NotificationLevel     @default(WARNING)
  title           String
  details         Json?
  subjectType     String
  subjectId       String
  assigneeType    TaskAssigneeType      @default(UNASSIGNED)
  assigneeUserId  String?
  assigneeAgentId String?
  dedupKey        String
  sourceEventId   String?
  resolvedById    String?
  resolutionNote  String?
  caseNumber      String?
  slaDueAt        DateTime?
  escalatedAt     DateTime?
  notes           Json?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  resolvedAt      DateTime?

  @@unique([tenantId, dedupKey])
  @@index([tenantId, status, assigneeType])
  @@index([tenantId, assigneeAgentId, status])
  @@index([tenantId, status, slaDueAt])
  @@map("operational_tasks")
}

// ---------------------------------------------------------------------------
// Phase fleet — Maintenance Orders & Compliance Documents
// ---------------------------------------------------------------------------

model MaintenanceOrder {
  id            String                 @id @default(cuid())
  tenantId      String
  vehicleId     String?
  trailerId     String?
  type          MaintenanceType        @default(REPAIR)
  status        MaintenanceOrderStatus @default(OPEN)
  description   String
  odometerKm    Int?
  costAmount    Decimal?               @db.Decimal(12, 2)
  costCurrency  String                 @default("CAD")
  vendor        String?
  dueDate       DateTime?
  dueOdometerKm Int?
  scheduleId    String?
  openedAt      DateTime               @default(now())
  completedAt   DateTime?
  createdById   String?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  tenant   Tenant               @relation(fields: [tenantId], references: [id])
  vehicle  Vehicle?             @relation(fields: [vehicleId], references: [id])
  trailer  Trailer?             @relation(fields: [trailerId], references: [id])
  schedule MaintenanceSchedule? @relation(fields: [scheduleId], references: [id])

  @@index([tenantId, status])
  @@index([tenantId, vehicleId])
  @@index([tenantId, scheduleId])
  @@map("maintenance_orders")
}

/// Preventive-maintenance plan: an interval (days and/or km) per asset. The cron
/// computes due/overdue from the anchor; completing a linked work order advances
/// the anchor so the cycle continues. Asset status is never derived from this.
model MaintenanceSchedule {
  id               String          @id @default(cuid())
  tenantId         String
  vehicleId        String?
  trailerId        String?
  name             String
  type             MaintenanceType @default(PREVENTIVE)
  intervalDays     Int?
  intervalKm       Int?
  anchorDate       DateTime        @default(now())
  anchorOdometerKm Int?
  leadDays         Int             @default(7)
  isActive         Boolean         @default(true)
  createdById      String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  tenant  Tenant             @relation(fields: [tenantId], references: [id])
  vehicle Vehicle?           @relation(fields: [vehicleId], references: [id])
  trailer Trailer?           @relation(fields: [trailerId], references: [id])
  orders  MaintenanceOrder[]

  @@index([tenantId, isActive])
  @@index([tenantId, vehicleId])
  @@index([tenantId, trailerId])
  @@map("maintenance_schedules")
}

model ComplianceDocument {
  id          String            @id @default(cuid())
  tenantId    String
  subjectType ComplianceSubject
  subjectId   String
  docType     ComplianceDocType
  reference   String?
  issuedAt    DateTime?
  expiresAt   DateTime
  documentId  String?
  notes       String?
  createdById String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, subjectType, subjectId])
  @@index([tenantId, expiresAt])
  @@map("compliance_documents")
}

enum StockMovementType {
  RECEIPT
  MOVE
  PICK
  ADJUSTMENT
}

enum BinKind {
  RECEIVING
  STORAGE
  SHIPPING
}

enum ReceiptStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum PickOrderStatus {
  OPEN
  PICKED
  COMPLETED
  CANCELLED
}

model WmsItem {
  id           String   @id @default(cuid())
  tenantId     String
  sku          String
  name         String
  unit         String   @default("EA")
  barcode      String?
  reorderPoint Int?
  reorderQty   Int?
  isActive     Boolean  @default(true)
  createdById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  levels          InventoryLevel[]
  movements       StockMovement[]
  receiptLines    ReceiptLine[]
  pickLines       PickLine[]
  cycleCountLines CycleCountLine[]

  @@unique([tenantId, sku])
  @@index([tenantId])
  @@map("wms_items")
}

enum CycleCountStatus {
  OPEN
  COUNTED
  RECONCILED
  CANCELLED
}

/// Recurring inventory-accuracy loop: snapshot a bin's per-item system qty, record
/// the physical count, then reconcile — variances post ADJUSTMENT movements via
/// InventoryService (rule 33; never below 0).
model CycleCount {
  id           String           @id @default(cuid())
  tenantId     String
  number       String
  binId        String
  status       CycleCountStatus @default(OPEN)
  note         String?
  countedAt    DateTime?
  reconciledAt DateTime?
  createdById  String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  tenant Tenant           @relation(fields: [tenantId], references: [id])
  bin    Bin              @relation(fields: [binId], references: [id])
  lines  CycleCountLine[]

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@index([tenantId, binId])
  @@map("wms_cycle_counts")
}

model CycleCountLine {
  id           String   @id @default(cuid())
  tenantId     String
  cycleCountId String
  itemId       String
  systemQty    Decimal  @db.Decimal(14, 3)
  countedQty   Decimal? @db.Decimal(14, 3)
  createdAt    DateTime @default(now())

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  cycleCount CycleCount @relation(fields: [cycleCountId], references: [id], onDelete: Cascade)
  item       WmsItem    @relation(fields: [itemId], references: [id])

  @@index([tenantId, cycleCountId])
  @@map("wms_cycle_count_lines")
}

model Bin {
  id         String   @id @default(cuid())
  tenantId   String
  locationId String
  code       String
  kind       BinKind  @default(STORAGE)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant       Tenant           @relation(fields: [tenantId], references: [id])
  location     Location         @relation(fields: [locationId], references: [id])
  levels       InventoryLevel[]
  movementsFrom StockMovement[] @relation("MovementFromBin")
  movementsTo   StockMovement[] @relation("MovementToBin")
  receiptLines ReceiptLine[]
  pickLines    PickLine[]
  cycleCounts  CycleCount[]

  @@unique([tenantId, locationId, code])
  @@index([tenantId, locationId])
  @@map("wms_bins")
}

model InventoryLevel {
  id        String   @id @default(cuid())
  tenantId  String
  itemId    String
  binId     String
  qtyOnHand Decimal  @default(0) @db.Decimal(14, 3)
  updatedAt DateTime @updatedAt

  tenant Tenant  @relation(fields: [tenantId], references: [id])
  item   WmsItem @relation(fields: [itemId], references: [id])
  bin    Bin     @relation(fields: [binId], references: [id])

  @@unique([tenantId, itemId, binId])
  @@index([tenantId, itemId])
  @@index([tenantId, binId])
  @@map("wms_inventory_levels")
}

model StockMovement {
  id          String            @id @default(cuid())
  tenantId    String
  type        StockMovementType
  itemId      String
  fromBinId   String?
  toBinId     String?
  qty         Decimal           @db.Decimal(14, 3)
  refType     String?
  refId       String?
  note        String?
  createdById String?
  createdAt   DateTime          @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  item    WmsItem @relation(fields: [itemId], references: [id])
  fromBin Bin?    @relation("MovementFromBin", fields: [fromBinId], references: [id])
  toBin   Bin?    @relation("MovementToBin", fields: [toBinId], references: [id])

  @@index([tenantId, itemId])
  @@index([tenantId, createdAt])
  @@index([tenantId, refType, refId])
  @@map("wms_stock_movements")
}

model Receipt {
  id          String        @id @default(cuid())
  tenantId    String
  number      String
  locationId  String
  status      ReceiptStatus @default(DRAFT)
  reference   String?
  note        String?
  postedAt    DateTime?
  createdById String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  tenant   Tenant        @relation(fields: [tenantId], references: [id])
  location Location      @relation(fields: [locationId], references: [id])
  lines    ReceiptLine[]

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@map("wms_receipts")
}

model ReceiptLine {
  id        String  @id @default(cuid())
  tenantId  String
  receiptId String
  itemId    String
  toBinId   String
  qty       Decimal @db.Decimal(14, 3)

  receipt Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  item    WmsItem @relation(fields: [itemId], references: [id])
  toBin   Bin     @relation(fields: [toBinId], references: [id])

  @@index([tenantId, receiptId])
  @@map("wms_receipt_lines")
}

model PickOrder {
  id          String          @id @default(cuid())
  tenantId    String
  number      String
  locationId  String
  shipmentId  String?
  status      PickOrderStatus @default(OPEN)
  reference   String?
  note        String?
  completedAt DateTime?
  createdById String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  tenant   Tenant     @relation(fields: [tenantId], references: [id])
  location Location   @relation(fields: [locationId], references: [id])
  shipment Shipment?  @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  lines    PickLine[]

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@index([tenantId, shipmentId])
  @@map("wms_pick_orders")
}

model PickLine {
  id          String  @id @default(cuid())
  tenantId    String
  pickOrderId String
  itemId      String
  fromBinId   String
  qty         Decimal @db.Decimal(14, 3)

  pickOrder PickOrder @relation(fields: [pickOrderId], references: [id], onDelete: Cascade)
  item      WmsItem   @relation(fields: [itemId], references: [id])
  fromBin   Bin       @relation(fields: [fromBinId], references: [id])

  @@index([tenantId, pickOrderId])
  @@map("wms_pick_lines")
}

enum YardSpotType {
  DOCK_DOOR
  PARKING
  STAGING
}

enum YardDirection {
  INBOUND
  OUTBOUND
  OTHER
}

enum YardVisitStatus {
  CHECKED_IN
  ASSIGNED
  DEPARTED
  CANCELLED
}

enum DockAppointmentStatus {
  SCHEDULED
  ARRIVED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model YardSpot {
  id         String       @id @default(cuid())
  tenantId   String
  locationId String
  code       String
  type       YardSpotType @default(PARKING)
  posX       Int?
  posY       Int?
  isActive   Boolean      @default(true)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  tenant       Tenant            @relation(fields: [tenantId], references: [id])
  location     Location          @relation(fields: [locationId], references: [id])
  visits       YardVisit[]
  appointments DockAppointment[]
  movesFrom    YardMove[]        @relation("YardMoveFrom")
  movesTo      YardMove[]        @relation("YardMoveTo")

  @@unique([tenantId, locationId, code])
  @@index([tenantId, locationId])
  @@map("yard_spots")
}

model YardVisit {
  id            String          @id @default(cuid())
  tenantId      String
  visitNumber   String
  locationId    String
  trailerId     String?
  trailerRef    String?
  carrierId     String?
  driverName    String?
  direction     YardDirection   @default(OTHER)
  status        YardVisitStatus @default(CHECKED_IN)
  spotId        String?
  appointmentId String?
  checkInAt     DateTime        @default(now())
  checkOutAt    DateTime?
  notes         String?
  createdById   String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  location    Location         @relation(fields: [locationId], references: [id])
  trailer     Trailer?         @relation(fields: [trailerId], references: [id])
  carrier     Carrier?         @relation(fields: [carrierId], references: [id])
  spot        YardSpot?        @relation(fields: [spotId], references: [id])
  appointment DockAppointment? @relation(fields: [appointmentId], references: [id])
  moves       YardMove[]

  @@unique([tenantId, visitNumber])
  @@index([tenantId, status])
  @@index([tenantId, spotId])
  @@map("yard_visits")
}

model YardMove {
  id          String   @id @default(cuid())
  tenantId    String
  visitId     String
  fromSpotId  String?
  toSpotId    String?
  movedAt     DateTime @default(now())
  note        String?
  createdById String?

  tenant  Tenant    @relation(fields: [tenantId], references: [id])
  visit   YardVisit @relation(fields: [visitId], references: [id], onDelete: Cascade)
  fromSpot YardSpot? @relation("YardMoveFrom", fields: [fromSpotId], references: [id])
  toSpot   YardSpot? @relation("YardMoveTo", fields: [toSpotId], references: [id])

  @@index([tenantId, visitId])
  @@map("yard_moves")
}

model DockAppointment {
  id                String                @id @default(cuid())
  tenantId          String
  appointmentNumber String
  locationId        String
  spotId            String?
  carrierId         String?
  direction         YardDirection         @default(INBOUND)
  windowStart       DateTime
  windowEnd         DateTime
  reference         String?
  status            DockAppointmentStatus @default(SCHEDULED)
  notes             String?
  createdById       String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  tenant   Tenant      @relation(fields: [tenantId], references: [id])
  location Location    @relation(fields: [locationId], references: [id])
  spot     YardSpot?   @relation(fields: [spotId], references: [id])
  carrier  Carrier?    @relation(fields: [carrierId], references: [id])
  visits   YardVisit[]

  @@unique([tenantId, appointmentNumber])
  @@index([tenantId, status])
  @@index([tenantId, windowStart])
  @@map("dock_appointments")
}

// ============================================================================
// CONNECT — Ingestion / Inbox
// ============================================================================

enum InboundSource {
  CSV
  PDF
  DOCUMENT
  WEBHOOK
}

enum InboundStatus {
  RECEIVED
  PARSED
  IMPORTED
  FAILED
  IGNORED
}

enum ImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ImportRowStatus {
  IMPORTED
  FAILED
}

model InboundMessage {
  id          String        @id @default(cuid())
  tenantId    String
  source      InboundSource
  status      InboundStatus @default(RECEIVED)
  kind        String?
  summary     String
  documentId  String?
  parsed      Json?
  error       String?
  refType     String?
  refId       String?
  createdById String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, status, createdAt])
  @@map("inbound_messages")
}

model ImportBatch {
  id           String       @id @default(cuid())
  tenantId     String
  number       String?
  target       String
  status       ImportStatus @default(PENDING)
  totalRows    Int          @default(0)
  importedRows Int          @default(0)
  failedRows   Int          @default(0)
  mapping      Json
  documentId   String?
  error        String?
  createdById  String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  tenant Tenant      @relation(fields: [tenantId], references: [id])
  rows   ImportRow[]

  @@index([tenantId, status, createdAt])
  @@map("import_batches")
}

model ImportRow {
  id        String          @id @default(cuid())
  tenantId  String
  batchId   String
  rowIndex  Int
  status    ImportRowStatus
  error     String?
  data      Json
  createdAt DateTime        @default(now())

  tenant Tenant      @relation(fields: [tenantId], references: [id])
  batch  ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([tenantId, batchId])
  @@map("import_rows")
}
