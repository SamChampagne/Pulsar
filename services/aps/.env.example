DATABASE_URL=postgresql+psycopg://plani:plani@localhost:5432/planiadvance_v2
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
# Optional. When set, all /integration endpoints require X-API-Key.
INTEGRATION_API_KEY=
# Optional limited keys. INTEGRATION_API_KEY still grants full access.
INTEGRATION_READ_API_KEY=
INTEGRATION_RUN_API_KEY=
# Optional integration safety limits.
INTEGRATION_MAX_CSV_BYTES=2000000
INTEGRATION_MAX_WORK_ORDERS=10000
INTEGRATION_MAX_OPERATIONS=50000
INTEGRATION_RATE_LIMIT_PER_MINUTE=120

# Reports - enable HTML preview routes (dev only). MUST stay False in prod.
REPORTS_HTML_PREVIEW_ENABLED=false

# Auth session signing key (HMAC-SHA256 over the encoded session token).
# When unset, the API generates a random key per process — every container
# restart invalidates every signed-in session and forces re-login. Set this
# to any non-empty string (>=32 random chars in prod, anything in dev) to
# make sessions survive restarts. Rotate this in prod to invalidate every
# active session.
AUTH_SESSION_SECRET=dev-only-not-for-prod-replace-me-with-32-random-bytes
